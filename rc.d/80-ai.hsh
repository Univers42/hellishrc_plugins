#!/usr/bin/env polish
# 80-ai.hsh — the AI block of the shell's own rc example.
#
# ── STATUS ON THIS BUILD ────────────────────────────────────────────────────
# On a binary without the `ai` builtin the interface below does not exist:
# `ai setup`, `set -o ai` and `set +o ai` fail with "command not found" /
# "invalid option name" (issue #71 §8). The suggest switch is still exported
# because it is inert when unread and correct the moment the builtin ships.
#
# Every knob is named with the running shell's prefix (HX_VARPFX: POLISH_ on
# 3.4+, which also answers to the HELLISH_ spelling; HELLISH_ before it).
#
# Toggle this whole module with:  conf off ai
hx_feature ai on ai "the shipped AI block (inert without an 'ai' builtin)"
hx_guard ai || return 0

# AI is ON by default in interactive mode. Turn it off any time with:
#     set +o ai
#
# ── AI backend ───────────────────────────────────────────────────────────────
# Out of the box the shell talks to a LOCAL llama.cpp server at 127.0.0.1:8080.
# Start one (a model lives in a docker volume; pulled once):
#     make ai-pull MODEL=<https url to a .gguf>
#     make ai-up                 # CPU (universal). Or: COMPUTE=hybrid / COMPUTE=gpu
# See docs/AI-COMPUTE.md for the CPU / hybrid / GPU trade-offs.
#
# For crazy-fast + high-intelligence answers, point it at a cloud API instead.
# Easiest — run once and it writes the block for you:
#     ai setup groq            # free key from console.groq.com (prompted, hidden)
#     ai setup openrouter      # Claude / many models via OpenRouter
#     ai setup openai          # gpt-4o-mini, etc.
#
# …or configure by hand (any OpenAI-compatible API). A cloud primary falls back
# to the local server automatically on error / rate-limit:
#     export POLISH_AI_URL=https://api.groq.com/openai/v1/chat/completions
#     export POLISH_AI_KEY=gsk_your_key_here
#     export POLISH_AI_MODEL=llama-3.3-70b-versatile
#
# Full reference: docs/AI.md   (commands, keybindings, env vars, privacy).
export "${HX_VARPFX:-POLISH_}AI_SUGGEST=1"
hx_var_doc "${HX_VARPFX:-POLISH_}AI_SUGGEST" "AI inline suggestions (inert until the 'ai' builtin ships)"
