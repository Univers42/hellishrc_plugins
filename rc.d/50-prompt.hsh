# 50-prompt.hsh — load the themes and put one on.
#
# The engine is lib/prompt.hsh. This module is the part that belongs to a
# configuration rather than to a framework: which directory themes come from,
# which one is on, and the compatibility surface for anything that was written
# against the older five-theme `theme` function.
hx_feature prompt on ui "prompt: 30 themes, a token language, and the switcher"
hx_guard prompt || return 0

# The upstream \A animation escape repaints the prompt while the shell is
# idle, and hellish's own documentation warns it can corrupt some terminals.
# Nothing here uses \A; this makes the decision explicit rather than default.
HELLISH_ANIM=off
hx_var_doc HELLISH_ANIM "prompt animation: off, and deliberately so (upstream warns it can corrupt terminals)"

# ── themes ──────────────────────────────────────────────────────────────────
# One file per family, lexical order, 90-local.hsh last so a theme of yours
# with a shipped name wins.
HX_THEME_DIR="${HX_THEME_DIR:-$HX_HOME/themes}"
hx_var_doc HX_THEME_DIR "where prompt themes live (~/.hellish/themes)"
hx_load_dir "$HX_THEME_DIR"

# ── compatibility: hx_precmd_add ────────────────────────────────────────────
#
# This configuration has always exposed hx_precmd_add, and plugins call it.
# It is now a front-end to hx_hook_add, which uses hellish's own
# HELLISH_PRECMD_FUNCS array when the binary has one (2.9+) and falls back to
# the PROMPT_COMMAND dispatch list when it does not.
#
# Both paths stay wired at once, and _hx_precmd_run is what keeps that from
# running every hook twice: when the native arrays exist, they are the only
# thing that runs, and the dispatcher returns immediately.
hx_precmd_add() { hx_hook_add precmd "$1"; }
hx_func_doc hx_precmd_add "register a function to run before each prompt" "hx_precmd_add <function>"

hx_preexec_add() { hx_hook_add preexec "$1"; }
hx_func_doc hx_preexec_add "register a function to run before each typed command (gets the line as \$1)" "hx_preexec_add <function>"

_hx_precmd_run() {
    hx_cap hooks && return 0      # the native arrays already ran everything
    local f
    for f in $HX_PRECMD_FUNCS; do
        command -v "$f" >/dev/null 2>&1 && "$f"
    done
    return 0
}
# Only when the native hook arrays are missing. _hx_precmd_run returns on its
# first line when `hx_cap hooks` is true, but "returns immediately" is not
# free: the shell still dispatches PROMPT_COMMAND once per prompt, and on
# hellish that is a full lex+parse+execute of the string. Setting it alongside
# HELLISH_PRECMD_FUNCS bought a wasted pipeline round-trip on every prompt to
# call a function whose first line is `return 0`.
hx_cap hooks || PROMPT_COMMAND='_hx_precmd_run'
hx_var_doc PROMPT_COMMAND "the fallback prompt hook; unset when hellish has native HELLISH_PRECMD_FUNCS"

# ── apply ───────────────────────────────────────────────────────────────────
# hellish.conf may name a theme that no longer exists -- an upgrade removed it,
# or it lived in a themes file that got deleted. Falling back to a known-good
# theme is better than a shell whose PS1 is empty.
HX_THEME="${HX_THEME:-vault}"
if ! hx_theme_known "$HX_THEME"; then
    hx_error_record "unknown theme '$HX_THEME' in hellish.conf; using 'vault'"
    HX_THEME=vault
fi
hx_prompt_apply "$HX_THEME" >/dev/null 2>&1

hx_var_doc HX_THEME      "the prompt theme (prompt list to browse, prompt save to keep)"
hx_var_doc HX_PATH_STYLE "how {path} is drawn: smart | short | fish | tail | full"
hx_var_doc HX_PATH_MAX   "path components before {path} elides the middle"
hx_var_doc HX_NERD       "1 to use powerline glyphs (needs a patched font)"
hx_var_doc HX_PS_ACCENT  "the palette colour themes lean on (prompt palette)"
