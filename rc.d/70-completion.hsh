# 70-completion.hsh — programmable completion.
#
# ── WHAT CHANGED ────────────────────────────────────────────────────────────
# This module used to be a REGISTRY and nothing else. On hellish 2.7.6 there
# was no way for a configuration to extend completion:
#
#     hellish -c 'complete -W "a b" foo'   -> complete: command not found
#     hellish -c 'compgen -W "a b"'        -> compgen: command not found
#
# So plugins declared the completions they WOULD install, and the day
# `complete` landed, one function would install the lot.
#
# That day has been and gone: `complete`, `compgen` and `shopt -s progcomp`
# are all real now. hx_complete_flush is no longer a no-op, and the wordlists
# every plugin has been declaring all along light up on TAB without a single
# plugin changing a line. That is the whole point of having declared them
# against an interface that did not exist yet.
#
# The registry stays, for three reasons: it still documents what a command
# accepts (help_conf reads it), it still works on an old binary, and
# hx_complete_show is a useful "what are this command's subcommands again?"
# even where TAB already answers.
hx_feature completion on core "TAB completion for this configuration's own commands"
hx_guard completion || return 0

declare -A HX_COMPL_WORDS

# hx_complete <command> <word...> — declare a static completion wordlist.
hx_complete() {
    local cmd="$1"
    shift
    hx_key_ok "$cmd" || return 1
    hx_aset HX_COMPL_WORDS "$cmd" "$*"
    # Install immediately when the shell can, so a plugin that calls
    # hx_complete after the flush below is not left out.
    if hx_cap builtin_complete && [ -n "$*" ]; then
        complete -W "$*" "$cmd" 2>/dev/null
    fi
    return 0
}
hx_func_doc hx_complete "declare (and install) a completion wordlist for a command" "hx_complete <cmd> <word>..."

# hx_complete_flush — install every declared completion.
hx_complete_flush() {
    hx_cap builtin_complete || return 0
    local c
    for c in "${!HX_COMPL_WORDS[@]}"; do
        [ -n "${HX_COMPL_WORDS[$c]}" ] || continue
        complete -W "${HX_COMPL_WORDS[$c]}" "$c" 2>/dev/null
    done
    return 0
}
hx_func_doc hx_complete_flush "install every declared completion wordlist"

# hx_complete_show [cmd] — what a command accepts, without pressing TAB.
hx_complete_show() {
    local c
    if [ -n "${1:-}" ]; then
        printf '%s\n' "${HX_COMPL_WORDS[$1]:-<none declared>}"
        return 0
    fi
    hx_head "completions"
    hx_kv "installed" "$(hx_cap builtin_complete && echo "yes — this hellish has \`complete\`" || echo "no — declared only, this hellish has no \`complete\`")"
    printf '\n'
    for c in $(printf '%s\n' "${!HX_COMPL_WORDS[@]}" | sort); do
        hx_kv "$c" "${HX_COMPL_WORDS[$c]}"
    done
    printf '\n'
}
hx_func_doc hx_complete_show "show declared completion wordlists" "hx_complete_show [cmd]"

# progcomp is what makes an installed `complete` spec actually reach TAB.
# It is off by default in hellish, so a configuration that installs
# completions has to arm it -- otherwise every spec below is inert and there
# is nothing to say so.
hx_cap builtin_complete && shopt -s progcomp 2>/dev/null
hx_opt_doc "progcomp" "armed here: without it an installed \`complete\` spec never reaches TAB"

# ── this configuration's own commands ───────────────────────────────────────
hx_complete conf  list on off toggle get set save reload reset edit path doctor profile modules caps help
hx_complete hxp   list info enable disable install remove update catalog doctor path new help
hx_complete forge new lint doc list api help
hx_complete prompt list preview gallery next prev random save edit new export tokens palette colors width nerd doctor reload help
hx_complete theme list preview gallery next prev random save edit new export tokens palette colors width nerd doctor reload help
hx_complete help_conf features aliases functions commands plugins vars options

# Functions defined in 40-functions.hsh. They are completed HERE rather than
# there because hx_complete does not exist yet at 40-: calling it from that
# module printed "hx_complete: command not found" on every shell start.
hx_complete extract
hx_complete pack
hx_complete note
hx_complete cheat nav find git dev disk prompt conf all
hx_complete guide tour prompt plugins arch trouble reference

# Themes and features are the two wordlists worth generating from the live
# registry rather than hard-coding: they change when a plugin is installed or
# a theme is written, and a stale completion list is worse than none.
hx_complete_dynamic() {
    hx_cap builtin_complete || return 0
    local names
    names=$(hx_theme_names 2>/dev/null | tr '\n' ' ')
    [ -n "$names" ] && {
        complete -W "$names list preview gallery next prev random save edit new export tokens palette colors width nerd doctor reload help" prompt 2>/dev/null
        complete -W "$names list preview gallery next prev random save edit new export tokens palette colors width nerd doctor reload help" theme 2>/dev/null
    }
    names=$(hx_feat_names_sorted 2>/dev/null | tr '\n' ' ')
    [ -n "$names" ] && {
        complete -W "on off toggle $names" conf 2>/dev/null
    }
    return 0
}
hx_func_doc hx_complete_dynamic "rebuild the completions that depend on the live registry"

hx_complete_flush

# ── KEYBINDINGS — still unavailable ─────────────────────────────────────────
# `bind` does not exist on any hellish released so far, so none of this can be
# set from an rc. Kept verbatim so it can be uncommented the day it lands; the
# capability probe already reports it as builtin_bind.
#
#   bind '"\e[A": history-search-backward'   # Up  = prefix search
#   bind '"\e[B": history-search-forward'    # Down= prefix search
#   bind 'set completion-ignore-case on'
#   bind '"\C-w": backward-kill-word'
#
# `set -o emacs` / `set -o vi` DO work (20-options.hsh) and are the only line
# editing control an rc currently has.
hx_opt_doc "bind" "NOT available: no \`bind\` builtin, so key bindings cannot be set from an rc"
