# ~/.hellish/hellish.conf
# Written by `conf save`. Hand-editing is fine: one directive per line.
#   feature <name> <on|off>   toggle a module or plugin
#   set     <VAR> <value>     set a configuration variable
# Generated 2026-09-16 14:46:10

feature ai               on
feature aliases          on
feature clean            on
feature completion       on
feature devkit           on
feature docker           on
feature env              on
feature forge            on
feature functions        on
feature git              on
feature history          on
feature jump             on
feature local            on
feature net              on
feature options          on
feature prompt           on
feature sentinel         on

set HX_THEME         vault
set HX_COLOR         auto
set HX_NERD          0
set HX_PATH_STYLE    smart
set HX_PATH_MAX      4
set HX_HIST_SIZE     20000
