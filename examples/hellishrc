# ============================================================================
# 11. RENDERER + HOOKS
# ============================================================================

HX_T0=''
HX_MS=0
HX_PKEY=''
HX_PCACHED=''
HX_RWKEY=''
HX_RWVAL=0
HX_LWKEY=''
HX_LWVAL=0
HX_THEME_OK=''
HX_DURSTR=''
HX_ARMED=0

# --- preexec ----------------------------------------------------------------
#
# THE DOUBLE-FIRE. hellish runs the DEBUG trap twice per command: once before
# the command, and again immediately before PROMPT_COMMAND. bash fires it once
# per simple command, which is a different wrong. Either way, a naive
#
#     trap 'HX_T0=$(now)' DEBUG
#
# re-stamps the start time after the command has already finished, so every
# duration reads as zero and the feature silently does nothing.
#
# The fix is a one-bit state machine. hx_precmd disarms; the first DEBUG fire
# after that arms and stamps; every later fire in the same command line is
# ignored. Measured against `sleep 2` in the test suite, so it stays fixed.
hx_preexec() {
    [ "$HX_ARMED" = "1" ] && return 0
    HX_ARMED=1
    hx_now_ms
    HX_T0="$HX_RET"
    :
}

hx_timing() {
    HX_MS=0
    HX_DURSTR=''
    if [ -n "$HX_T0" ]; then
        hx_now_ms
        HX_MS=$((HX_RET - HX_T0))
        [ "$HX_MS" -lt 0 ] && HX_MS=0
        if [ "$HX_MS" -ge "$HX_DUR_MIN" ]; then
            hx_dur "$HX_MS"
            HX_DURSTR="$HX_RET"
        fi
    fi
    HX_T0=''
    HX_ARMED=0
}

hx_collect() {
    HX_X="$1"
    case "$HX_X" in ''|*[!0-9]*) HX_X=0 ;; esac
    HX_XOK=1
    [ "$HX_X" = "0" ] || HX_XOK=0
    hx_signame "$HX_X"
    HX_XSIG="$HX_RET"

    # The path only changes with a cd or a config change, so it is
    # shortened once per (directory, style) pair.
    if [ "$HX_PKEY" != "$PWD|$HX_PATH_STYLE|$HX_PATH_MAX" ]; then
        HX_PKEY="$PWD|$HX_PATH_STYLE|$HX_PATH_MAX"
        hx_shorten "$PWD"
        hx_pct "$HX_RET"
        HX_PCACHED="$HX_RET"
    fi
    HX_P="$HX_PCACHED"

    hx_misc_collect
    hx_where_collect
    hx_git_collect
    hx_git_label
    hx_cached_collect
    hx_cloud_collect
    hx_sys_collect
    :
}

hx_title() {
    [ "$HX_TITLE" = "1" ] || return 0
    case "${TERM-}" in
        xterm*|rxvt*|screen*|tmux*|alacritty*|foot*|kitty*|wezterm*|ghostty*)
            printf '\033]0;%s@%s: %s\007' "$HX_U" "$HX_H" "$PWD"
            ;;
    esac
}

# Build HX_PS1/HX_RPS1 for the active theme, with a hard fallback if the
# theme function is missing or explodes.
hx_build() {
    HX_PS1=''
    HX_RPS1=''
    # Validated once per theme name, not once per prompt: the check is a
    # walk of the theme list, and the call it guards used to be a
    # `command -v` plus a redirection on every render.
    if [ "$HX_THEME" != "$HX_THEME_OK" ] && hx_theme_valid "$HX_THEME"; then
        HX_THEME_OK="$HX_THEME"
    fi
    if [ "$HX_THEME" = "$HX_THEME_OK" ]; then
        "hx_theme_$HX_THEME"
    fi
    if [ -z "$HX_PS1" ]; then
        HX_PS1="$HX_U@$HX_H $HX_P$HX_PRIV "
        HX_RPS1=''
    fi
}

# --- right prompt -----------------------------------------------------------
#
# zsh and hellish have a real RPROMPT: the shell paints it, keeps it clear of
# the typed line, and repaints it after a resize. hellish reads it in zsh's
# prompt syntax, so a literal % in it has to be doubled (hx_rprompt_native).
# Everywhere else the right prompt is emulated: printing the string
# right-aligned and then returning the cursor to column 0 with a carriage
# return leaves it on screen, and the left prompt is drawn over the left of
# the same line.
#
# The left prompt's first line must be short enough not to collide, so the
# emulation stands down when the two would overlap. Padding uses a width
# estimate that only ever errs large (see hx_vwidth), which shifts the right
# prompt left rather than wrapping the line.
hx_rprompt_emit() {
    [ "$HX_RPROMPT" = "1" ] || return 0
    [ -n "$HX_RPS1" ] || return 0
    [ "$HX_SHELL" = "zsh" ] && return 0
    [ -t 1 ] || return 0

    # First line of the left prompt is what shares the row. Both widths
    # are remembered with the strings they were measured from: most
    # prompts render the same two strings as the last one did.
    hx_l1="${HX_PS1%%"$HX_NL"*}"
    if [ "$HX_RWKEY" != "$HX_RPS1" ]; then
        hx_vwidth "$HX_RPS1"
        HX_RWKEY="$HX_RPS1"
        HX_RWVAL="$HX_W"
    fi
    if [ "$HX_LWKEY" != "$hx_l1" ]; then
        hx_vwidth "$hx_l1"
        HX_LWKEY="$hx_l1"
        HX_LWVAL="$HX_W"
    fi
    hx_rw="$HX_RWVAL"
    hx_lw="$HX_LWVAL"

    hx_pad=$((HX_COLS - hx_rw))
    if [ "$hx_pad" -le "$hx_lw" ] || [ "$hx_pad" -lt 1 ]; then
        unset hx_rw hx_l1 hx_lw hx_pad
        return 0
    fi
    printf '%*s%s\r' "$hx_pad" '' "$HX_RPS1"
    unset hx_rw hx_l1 hx_lw hx_pad
}

hx_rprompt_native() {
    if [ "$HX_RPROMPT" = "1" ] && [ -n "$HX_RPS1" ]; then
        eval 'RPROMPT=${HX_RPS1//\%/%%}'
    else
        RPROMPT=''
    fi
}

hx_precmd() {
    HX_LAST=$?
    hx_timing
    hx_collect "$HX_LAST"
    hx_build
    hx_title
    PS1="$HX_PS1"
    PS2="$HX_fdark$HX_G_H$HX_G_H$HX_G_TRI$HX_r "
    if [ "$HX_SHELL" = "zsh" ]; then
        RPS1="$HX_RPS1"
        RPROMPT="$HX_RPS1"
    elif [ "$HX_NATIVE" = "1" ]; then
        hx_rprompt_native
    else
        hx_rprompt_emit
    fi
    :
}

# hellish repaints the prompt while a line is being read when its background
# git scan lands with a new answer (a large repository after a `cd`), and
# first runs the functions in HELLISH_PROMPT_REFRESH_FUNCS so a prompt built
# by a hook can follow. This one rebuilds from the fresh scan: variables
# only -- nothing is started, nothing is printed.
hx_refresh() {
    hx_git_collect
    hx_git_label
    hx_build
    PS1="$HX_PS1"
    hx_rprompt_native
}

# One-shot renderer for shells with no precmd hook (dash, and anything else
# without PROMPT_COMMAND). PS1 is expanded per POSIX with parameter expansion
# + command substitution, so this runs on every prompt.
hx_render() {
    hx_collect "${1:-0}"
    hx_build
    printf '%s' "$HX_PS1"
}

hx_hooks_install() {
    if [ "$HX_SHELL" = "zsh" ]; then
        setopt PROMPT_SUBST 2>/dev/null
        setopt PROMPT_PERCENT 2>/dev/null
        setopt TRANSIENT_RPROMPT 2>/dev/null
        # Defined as plain functions so this file stays POSIX-parseable.
        # If you already use add-zsh-hook elsewhere, drop these two defs.
        precmd() { hx_precmd; }
        preexec() { hx_preexec; }
        hx_precmd
    elif [ "$HX_SHELL" = "bash" ]; then
        PROMPT_COMMAND=hx_precmd
        if [ "$HX_NATIVE" = "1" ]; then
            case " ${HELLISH_PROMPT_REFRESH_FUNCS-} " in
                *" hx_refresh "*) : ;;
                *) HELLISH_PROMPT_REFRESH_FUNCS="${HELLISH_PROMPT_REFRESH_FUNCS:+$HELLISH_PROMPT_REFRESH_FUNCS }hx_refresh" ;;
            esac
        fi
        # NOTE: the DEBUG trap is NOT installed here. hellish silently
        # discards a DEBUG trap set inside a function body (a WINCH trap set
        # the same way survives, so this is specific to DEBUG), which left
        # HX_T0 unset and every command duration reading 0. It is installed
        # at top level in section 14 instead. See `hx doctor`.
        hx_precmd
    else
        PS1='$(hx_render "$?")'
        PS2='> '
    fi
    :
}

# ============================================================================
# 12. COMMAND SUITE: hx
# ============================================================================
#
# `hxp` is deliberately NOT used here. In a full install that name belongs to
# the plugin manager in ~/.hellish/lib/plugin.hsh, and claiming it would
# shadow `hxp list` / `hxp install`. This file owns `hx` and nothing else.

hx_theme_valid() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    for hx_t in $HX_THEMES; do
        [ "$hx_t" = "$1" ] && { unset hx_t; return 0; }
    done
    unset hx_t
    return 1
}

hx_theme_set() {
    if hx_theme_valid "$1"; then
        HX_THEME="$1"
        hx_hooks_install
        printf '%s\n' "$HX_THEME" > "$HX_STATE/theme" 2>/dev/null
        return 0
    fi
    printf 'hx: unknown theme: %s\n' "$1" >&2
    printf 'hx: try `hx theme list`\n' >&2
    return 1
}

hx_theme_index() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    hx_i=0
    hx_found=-1
    for hx_t in $HX_THEMES; do
        [ "$hx_t" = "$HX_THEME" ] && hx_found=$hx_i
        hx_i=$((hx_i + 1))
    done
    HX_COUNT=$hx_i
    HX_IDX=$hx_found
    unset hx_i hx_found hx_t
}

hx_theme_at() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    hx_i=0
    for hx_t in $HX_THEMES; do
        if [ "$hx_i" = "$1" ]; then
            HX_RET="$hx_t"
            unset hx_i hx_t
            return 0
        fi
        hx_i=$((hx_i + 1))
    done
    HX_RET=hellish
    unset hx_i hx_t
    return 1
}

# Render one theme against the live context, without disturbing the session.
hx_demo_one() {
    hx_old="$HX_THEME"
    HX_THEME="$1"
    hx_build
    printf '%s %s%s\n' "$HX_fdark$HX_G_H$HX_G_H" "$1" "$HX_r"
    printf '%s\n' "$HX_PS1"
    # HX_RPS1 is never empty once colour is on - it is at least a reset
    # sequence - so test what it actually renders, not the raw string.
    hx_strip "$HX_RPS1"
    case "$HX_RET" in
        *[!\ ]*) printf '   %sright:%s %s\n' "$HX_fdark" "$HX_r" "$HX_RPS1" ;;
    esac
    HX_THEME="$hx_old"
    hx_build
    unset hx_old
}

hx_head() { printf '\n%s%s%s\n' "$HX_bd$HX_forange" "$*" "$HX_r"; }
hx_row()  { printf '  %s%-16s%s %s\n' "$HX_fsteel" "$1" "$HX_r" "$2"; }

hx_rule() {
    hx_repeat "$HX_G_H" "$((HX_COLS - 2))"
    printf '%s%s%s\n' "$HX_fdark" "$HX_RET" "$HX_r"
}

hx_banner() {
    hx_rule
    printf '%s  hellish%s %s   %stheme%s %s   %sshell%s %s   %scolor%s %s   %sthemes%s %s\n' \
        "$HX_bd$HX_fcrim" "$HX_r" "$HX_VERSION" \
        "$HX_fdark" "$HX_r" "$HX_THEME" \
        "$HX_fdark" "$HX_r" "$([ "$HX_IS_HELLISH" = 1 ] && echo hellish || echo "$HX_SHELL")" \
        "$HX_fdark" "$HX_r" "$HX_COLOR" \
        "$HX_fdark" "$HX_r" "$(printf '%s\n' $HX_THEMES | grep -c .)"
    hx_rule
}

# hx bench [N] — how long does one prompt actually take?
#
# Measures hx_collect + hx_build, which is everything between the shell
# handing us control and PS1 being ready. The number that matters is the
# per-prompt figure: anything above ~50ms is felt as lag while typing.
hx_bench() {
    hx_n="${1:-50}"
    case "$hx_n" in ''|*[!0-9]*) hx_n=50 ;; esac

    printf '%sbenchmarking %s prompt renders in %s%s\n' \
        "$HX_fdark" "$hx_n" "$PWD" "$HX_r"

    hx_now_ms; hx_b0="$HX_RET"
    hx_i=0
    while [ "$hx_i" -lt "$hx_n" ]; do
        hx_collect 0
        hx_build
        hx_i=$((hx_i + 1))
    done
    hx_now_ms; hx_b1="$HX_RET"
    hx_tot=$((hx_b1 - hx_b0))

    # Again with the collectors skipped, to separate rendering from probing.
    hx_now_ms; hx_b0="$HX_RET"
    hx_i=0
    while [ "$hx_i" -lt "$hx_n" ]; do
        hx_build
        hx_i=$((hx_i + 1))
    done
    hx_now_ms; hx_b1="$HX_RET"
    hx_ren=$((hx_b1 - hx_b0))

    hx_head 'bench'
    hx_row 'iterations' "$hx_n"
    hx_row 'total' "${hx_tot}ms"
    hx_ms10 $hx_tot $hx_n;              hx_row 'per prompt' "$HX_RET"
    hx_ms10 $hx_ren $hx_n;              hx_row 'of which render' "$HX_RET"
    hx_ms10 $((hx_tot - hx_ren)) $hx_n; hx_row 'of which collect' "$HX_RET"
    hx_row 'cache' "$([ "$HX_CACHE" = 1 ] && echo on || echo off)"
    hx_row 'clock source' "$HX_CLOCK"
    printf '\n  %sthe collect figure is dominated by git; try it outside a repo%s\n' \
        "$HX_fdark" "$HX_r"
    unset hx_n hx_i hx_b0 hx_b1 hx_tot hx_ren
}

hx_doctor() {
    hx_head "hellishrc $HX_VERSION"
    hx_row 'shell'      "$HX_SHELL$([ "$HX_IS_HELLISH" = 1 ] && echo ' (hellish)')"
    hx_row 'interactive' "$HX_INTERACTIVE"
    hx_row 'color'      "$HX_COLOR"
    hx_row 'unicode'    "$HX_UNICODE$([ "$HX_NERD" = 1 ] && echo ' +nerd')"
    hx_row 'columns'    "$HX_COLS"
    hx_row 'clock'      "$HX_CLOCK"
    hx_row 'theme'      "$HX_THEME ($(printf '%s\n' $HX_THEMES | grep -c .) available)"
    hx_row 'hooks'      "$([ "$HX_SHELL" = posix ] && echo 'PS1 substitution' || echo 'PROMPT_COMMAND + DEBUG')"
    hx_rp=emulated
    { [ "$HX_SHELL" = zsh ] || [ "$HX_NATIVE" = 1 ]; } && hx_rp=native
    [ "$HX_RPROMPT" = 1 ] || hx_rp=off
    hx_row 'rprompt'    "$hx_rp"
    unset hx_rp
    hx_row 'git'        "$([ "$HX_NATIVE" = 1 ] && echo 'native (no process per prompt)' || echo 'one git status per prompt, in a repo')"
    hx_row 'cache'      "$([ "$HX_CACHE" = 1 ] && echo on || echo off)"

    hx_head 'paths'
    hx_row 'config'     "$HX_PROMPT_CONF$([ -r "$HX_PROMPT_CONF" ] || echo '  (not written yet)')"
    hx_row 'state'      "$HX_STATE"
    hx_row 'framework'  "$HX_HOME$([ -d "$HX_HOME/lib" ] && echo '  (plugin framework present)')"

    hx_head 'tools'
    for hx_t in git tput less kubectl docker fzf rg; do
        if hx_has "$hx_t"; then
            hx_row "$hx_t" "$HX_fgreen$HX_G_OK$HX_r"
        else
            hx_row "$hx_t" "$HX_fdark$HX_G_BAD not found$HX_r"
        fi
    done
    unset hx_t

    hx_head 'warnings'
    hx_w=0
    if [ "$HX_IS_HELLISH" = "1" ]; then
        printf '  %s%s%s hellish reports BASH_VERSION but is not bash:\n' "$HX_fyellow" "$HX_G_BOLT" "$HX_r"
        printf '      bind is missing, so key bindings come from ~/.inputrc;\n'
        printf '      see `hx keys`.\n'
        hx_w=$((hx_w + 1))
        if [ "$HX_NATIVE" = "0" ]; then
            printf '  %s%s%s this hellish predates HELLISH_GIT_*: the git segment\n' "$HX_fyellow" "$HX_G_BOLT" "$HX_r"
            printf '      runs git once per prompt; a newer hellish runs none.\n'
        fi
    fi
    if [ -f "$HX_HOME/hellish.conf" ] && [ ! -r "$HX_PROMPT_CONF" ]; then
        printf '  %s%s%s prompt config not written yet; `hx conf save` creates it.\n' "$HX_fdark" "$HX_G_DOT" "$HX_r"
    fi
    if [ "$HX_UNICODE" = "0" ] && [ "$HX_THEME" != "ascii" ]; then
        printf '  %s%s%s no UTF-8 locale detected; `hx theme set ascii` is the safe one.\n' "$HX_fyellow" "$HX_G_BOLT" "$HX_r"
        hx_w=$((hx_w + 1))
    fi
    [ "$hx_w" = "0" ] && printf '  %s%s nothing to report%s\n' "$HX_fgreen" "$HX_G_OK" "$HX_r"
    unset hx_w
    printf '\n'
}

hx_segments() {
    hx_collect "${1:-0}"
    hx_head 'exit'
    hx_row 'HX_X'      "$HX_X"
    hx_row 'HX_XSIG'   "${HX_XSIG:-$HX_fdark(none)$HX_r}"
    hx_head 'location'
    hx_row 'HX_P'      "$HX_P"
    hx_row 'HX_U/HX_H' "$HX_U@$HX_H"
    hx_row 'HX_CTR'    "${HX_CTR:-$HX_fdark(none)$HX_r}"
    hx_row 'HX_MUX'    "${HX_MUX:-$HX_fdark(none)$HX_r}"
    hx_row 'HX_SSHF'   "$HX_SSHF"
    hx_head 'git'
    hx_row 'HX_GREPO'  "${HX_GREPO:-$HX_fdark(not a repo)$HX_r}"
    hx_row 'HX_GB'     "${HX_GB:-$HX_fdark-$HX_r}"
    hx_row 'HX_GF'     "${HX_GF:-$HX_fdark(clean)$HX_r}"
    hx_row 'ahead/behind' "$HX_GA/$HX_GBH"
    hx_row 'HX_GS'     "$HX_GS"
    hx_row 'HX_GST'    "${HX_GST:-$HX_fdark(none)$HX_r}"
    hx_row 'HX_GLABEL' "${HX_GLABEL:-$HX_fdark-$HX_r}"
    hx_head 'toolchain'
    hx_row 'HX_LANG'   "${HX_LANG:-$HX_fdark(none)$HX_r}"
    hx_row 'HX_VENV'   "${HX_VENV:-$HX_fdark(none)$HX_r}"
    hx_row 'HX_KCTX'   "${HX_KCTX:-$HX_fdark(off)$HX_r}"
    hx_row 'HX_CLOUDP' "${HX_CLOUDP:-$HX_fdark(off)$HX_r}"
    hx_head 'system'
    hx_row 'HX_JOBS'   "$HX_JOBS"
    hx_row 'HX_LOAD'   "${HX_LOAD:-$HX_fdark(off)$HX_r}"
    hx_row 'HX_BAT'    "${HX_BAT:-$HX_fdark(none)$HX_r}${HX_BATST:+ $HX_BATST}"
    hx_row 'HX_TIME'   "$HX_TIME"
    hx_row 'HX_DURSTR' "${HX_DURSTR:-$HX_fdark(under threshold)$HX_r}"
    printf '\n'
}

hx_colors_card() {
    printf '%smode %s   unicode %s   shell %s   columns %s%s\n\n' \
        "$HX_fdark" "$HX_COLOR" "$HX_UNICODE" "$HX_SHELL" "$HX_COLS" "$HX_r"
    printf '%spalette%s\n' "$HX_bd$HX_forange" "$HX_r"
    for hx_spec in fred:red fcrim:crim fpink:pink forange:orange fsand:sand \
        fgold:gold fyellow:yellow flime:lime facid:acid fgreen:green fmoss:moss \
        fteal:teal fcyan:cyan fneon:neon fsky:sky fblue:blue fsteel:steel \
        fdeep:deep fviolet:violet fpurple:purple fmagenta:magenta fmauve:mauve \
        fslate:slate fgrey:grey fdark:dark
    do
        eval "hx_v=\$HX_${hx_spec%%:*}"
        printf '%s%s %-8s%s' "$hx_v" "$HX_G_HALF$HX_G_HALF" "${hx_spec#*:}" "$HX_r"
        hx_i=$((${hx_i:-0} + 1))
        [ $((hx_i % 5)) = 0 ] && printf '\n'
    done
    unset hx_spec hx_v
    [ $((hx_i % 5)) = 0 ] || printf '\n'
    hx_i=0
    printf '\n%s256 ramp%s\n' "$HX_bd$HX_forange" "$HX_r"
    while [ "$hx_i" -lt 256 ]; do
        printf '%s %3d %s' "$(hx_esc 48 "$hx_i")" "$hx_i" "$HX_r"
        hx_i=$((hx_i + 1))
        [ $((hx_i % 8)) = 0 ] && printf '\n'
    done
    unset hx_i
}

hx_glyphs_card() {
    printf '%sunicode=%s nerd=%s%s\n' "$HX_fdark" "$HX_UNICODE" "$HX_NERD" "$HX_r"
    hx_head 'box'
    printf '   %s %s %s %s   %s %s %s %s\n' \
        "$HX_G_TL" "$HX_G_TR" "$HX_G_BL" "$HX_G_V" \
        "$HX_G_H" "$HX_G_TLB" "$HX_G_BLB" "$HX_G_SQ"
    hx_head 'prompt'
    printf '   %s %s %s %s %s %s\n' \
        "$HX_G_ARR" "$HX_G_LAM" "$HX_G_TRI" "$HX_G_PL" "$HX_G_PLT" "$HX_G_DIAM"
    hx_head 'status'
    printf '   %s %s %s %s %s %s %s\n' \
        "$HX_G_OK" "$HX_G_BAD" "$HX_G_UP" "$HX_G_DN" \
        "$HX_G_STASH" "$HX_G_BOLT" "$HX_G_CLK"
    hx_head 'context'
    printf '   %s %s %s %s %s %s\n' \
        "$HX_G_BR" "$HX_G_HELM" "$HX_G_CLOUD" "$HX_G_BOX" "$HX_G_LOCK" "$HX_G_PLUG"
    printf '\n  %sif any of the above is a box or a blank, the font lacks it;%s\n' "$HX_fdark" "$HX_r"
    printf '  %s`hx conf set HX_UNICODE 0` falls the whole file back to ASCII.%s\n\n' "$HX_fdark" "$HX_r"
}

hx_keys_card() {
    hx_head 'what this shell honors'
    if [ "$HX_SHELL" = "zsh" ]; then
        hx_row 'history search' 'Up / Down (prefix-matched)'
        hx_row 'word motion'    'Ctrl+Left / Ctrl+Right'
        hx_row 'completion'     'menu select, case-insensitive'
        hx_row 'rprompt'        'native RPROMPT'
    elif [ "$HX_IS_HELLISH" = "1" ]; then
        hx_row 'rprompt'        'emulated (pad + carriage return)'
        hx_row 'prompt hook'    'PROMPT_COMMAND'
        hx_row 'timing hook'    'DEBUG trap, double-fire guarded'
        printf '\n  %shellish has no `bind` builtin and its `shopt` is a no-op,%s\n' "$HX_fdark" "$HX_r"
        printf '  %sso keybindings and shell options cannot be set from an rc.%s\n' "$HX_fdark" "$HX_r"
        printf '  %sEverything above is done without them.%s\n' "$HX_fdark" "$HX_r"
    else
        hx_row 'history search' 'Up / Down (via bind)'
        hx_row 'rprompt'        'emulated (pad + carriage return)'
        hx_row 'shell options'  'autocd, globstar, checkwinsize'
    fi
    printf '\n'
}

hx_conf_cmd() {
    hx_sub="${1-}"
    [ $# -gt 0 ] && shift
    case "$hx_sub" in
        ''|list|ls)
            hx_head 'configuration'
            for hx_k in $HX_KEYS; do
                eval "hx_v=\${$hx_k-}"
                hx_row "$hx_k" "$hx_v"
            done
            printf '\n  %sfile: %s%s\n\n' "$HX_fdark" "$HX_PROMPT_CONF" "$HX_r"
            unset hx_k hx_v
            ;;
        get)
            if hx_key_valid "${1-}"; then
                eval "printf '%s\\n' \"\${$1-}\""
            else
                printf 'hx conf: not a settable key: %s\n' "${1-}" >&2
                return 1
            fi
            ;;
        set)
            if ! hx_key_valid "${1-}"; then
                printf 'hx conf: not a settable key: %s\n' "${1-}" >&2
                printf 'hx conf: `hx conf list` shows every key\n' >&2
                return 1
            fi
            eval "$1=\$2"
            hx_conf_save && printf '%s=%s\n' "$1" "$2"
            # Colors, glyphs and the theme all need rebuilding on change.
            hx_palette
            hx_cache_drop
            hx_hooks_install
            ;;
        save)
            hx_conf_save && printf 'saved to %s\n' "$HX_PROMPT_CONF"
            ;;
        edit)
            "${EDITOR:-vi}" "$HX_PROMPT_CONF"
            hx_conf_load
            hx_hooks_install
            ;;
        reset)
            rm -f "$HX_PROMPT_CONF" 2>/dev/null
            printf 'removed %s; `hx reload` to return to defaults\n' "$HX_PROMPT_CONF"
            ;;
        *)
            printf 'hx conf: unknown subcommand: %s\n' "$hx_sub" >&2
            return 1
            ;;
    esac
    unset hx_sub
}

hx_theme_cmd() {
    hx_sub="${1-}"
    [ $# -gt 0 ] && shift
    case "$hx_sub" in
        ''|show|current)
            printf '%s\n' "$HX_THEME"
            ;;
        list|ls)
            for hx_t in $HX_THEMES; do
                if [ "$hx_t" = "$HX_THEME" ]; then
                    printf '%s  %s %s%s\n' "$HX_fgreen" "$HX_G_TRI" "$hx_t" "$HX_r"
                else
                    printf '    %s\n' "$hx_t"
                fi
            done
            unset hx_t
            ;;
        set|use)
            hx_theme_set "${1-}"
            ;;
        next)
            hx_theme_index
            hx_theme_at $(( (HX_IDX + 1) % HX_COUNT ))
            hx_theme_set "$HX_RET" && printf '%s\n' "$HX_THEME"
            ;;
        prev)
            hx_theme_index
            hx_theme_at $(( (HX_IDX + HX_COUNT - 1) % HX_COUNT ))
            hx_theme_set "$HX_RET" && printf '%s\n' "$HX_THEME"
            ;;
        random|rand)
            hx_theme_index
            hx_now_ms
            hx_theme_at $(( (HX_RET + $$) % HX_COUNT ))
            hx_theme_set "$HX_RET" && printf '%s\n' "$HX_THEME"
            ;;
        demo|preview)
            if [ -n "${1-}" ]; then
                hx_demo_one "$1"
            else
                hx_collect 0
                for hx_t in $HX_THEMES; do hx_demo_one "$hx_t"; done
                unset hx_t
            fi
            ;;
        *)
            hx_theme_set "$hx_sub"
            ;;
    esac
    unset hx_sub
}

