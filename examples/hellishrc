hx() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    hx_cmd="${1-}"
    [ $# -gt 0 ] && shift
    case "$hx_cmd" in
        '')            hx_banner; printf '\n  %shx help%s for everything\n\n' "$HX_fdark" "$HX_r" ;;
        theme|t)       hx_theme_cmd "$@" ;;
        conf|config|c) hx_conf_cmd "$@" ;;
        doctor|dr)     hx_doctor ;;
        bench)         hx_bench "$@" ;;
        segments|seg)  hx_segments "$@" ;;
        colors|color)  hx_colors_card ;;
        glyphs|glyph)  hx_glyphs_card ;;
        keys)          hx_keys_card ;;
        banner)        hx_banner ;;
        cache)
            case "${1-}" in
                drop|clear) hx_cache_drop; printf 'cache dropped\n' ;;
                *) printf 'pwd=%s lang=%s venv=%s\n' \
                    "${HX_CPWD:--}" "${HX_CLANG:--}" "${HX_CVENV:--}" ;;
            esac
            ;;
        reload)        hx_cache_drop; . "${HX_RC:-$HOME/.hellishrc}" ;;
        version|-v|--version) printf '%s\n' "$HX_VERSION" ;;
        help|-h|--help) hx_help ;;
        *)
            # `hx neon` is shorthand for `hx theme set neon`.
            if hx_theme_valid "$hx_cmd"; then
                hx_theme_set "$hx_cmd"
            else
                printf 'hx: unknown command: %s\n' "$hx_cmd" >&2
                printf 'hx: try `hx help`\n' >&2
                unset hx_cmd
                return 1
            fi
            ;;
    esac
    unset hx_cmd
}

alias theme='hx theme'
alias prompt='hx theme'

# ============================================================================
# 13. ERGONOMICS
# ============================================================================
#
# Split three ways, because the three shells genuinely differ:
#
#   zsh      setopt / zstyle / bindkey all work
#   bash     shopt / bind work
#   hellish  NEITHER works. `shopt -s anything` returns 0 and does nothing,
#            and `bind` is not a builtin at all. Aliases and functions are
#            all that survive, so that is all this branch defines.

if [ "$HX_ERGONOMICS" = "1" ] && [ "$HX_SHELL" = "zsh" ]; then
    HISTFILE="$HX_STATE/history"
    HISTSIZE=100000
    SAVEHIST=100000

    setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY 2>/dev/null
    setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE 2>/dev/null
    setopt HIST_REDUCE_BLANKS HIST_VERIFY EXTENDED_HISTORY 2>/dev/null
    setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT 2>/dev/null
    setopt EXTENDED_GLOB GLOB_DOTS NO_CASE_GLOB NUMERIC_GLOB_SORT 2>/dev/null
    setopt INTERACTIVE_COMMENTS LONG_LIST_JOBS NOTIFY 2>/dev/null
    setopt NO_BEEP NO_FLOW_CONTROL 2>/dev/null
    unsetopt CORRECT_ALL 2>/dev/null

    autoload -Uz compinit 2>/dev/null && compinit -C 2>/dev/null
    zstyle ':completion:*' menu select 2>/dev/null
    zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 2>/dev/null
    zstyle ':completion:*' list-colors '' 2>/dev/null
    zstyle ':completion:*:descriptions' format '%F{242}%d%f' 2>/dev/null

    bindkey -e 2>/dev/null
    bindkey '^[[A' history-search-backward 2>/dev/null
    bindkey '^[[B' history-search-forward 2>/dev/null
    bindkey '^[[1;5C' forward-word 2>/dev/null
    bindkey '^[[1;5D' backward-word 2>/dev/null

elif [ "$HX_ERGONOMICS" = "1" ] && [ "$HX_SHELL" = "bash" ] && [ "$HX_IS_HELLISH" = "0" ]; then
    HISTFILE="$HX_STATE/history"
    HISTSIZE=100000
    HISTFILESIZE=100000
    HISTCONTROL=ignoreboth:erasedups
    HISTTIMEFORMAT='%F %T  '

    shopt -s histappend cmdhist 2>/dev/null
    shopt -s autocd cdspell dirspell 2>/dev/null
    shopt -s checkwinsize globstar nocaseglob 2>/dev/null
    shopt -s no_empty_cmd_completion 2>/dev/null

    bind 'set completion-ignore-case on' 2>/dev/null
    bind 'set show-all-if-ambiguous on' 2>/dev/null
    bind '"\e[A": history-search-backward' 2>/dev/null
    bind '"\e[B": history-search-forward' 2>/dev/null
fi

if [ "$HX_ERGONOMICS" = "1" ]; then
    alias ll='ls -lhF'
    alias la='ls -lAhF'
    alias lt='ls -lhFt'
    alias ..='cd ..'
    alias ...='cd ../..'
    alias ....='cd ../../..'
    alias g='git'
    alias gs='git status --short --branch'
    alias gl='git log --oneline --graph --decorate -20'
    alias gd='git diff'
    alias gds='git diff --staged'

    # mkcd DIR — make it, enter it.
    mkcd() { mkdir -p "$1" && cd "$1" || return 1; }

    # up N — climb N directories.
    up() {
        hx_n="${1:-1}"
        hx_p=''
        while [ "$hx_n" -gt 0 ]; do
            hx_p="../$hx_p"
            hx_n=$((hx_n - 1))
        done
        cd "$hx_p" || return 1
        unset hx_n hx_p
    }

    # ff / fd PATTERN — find files / directories by name below $PWD.
    ff() { find . -type f -name "*$1*" 2>/dev/null; }
    fd() { find . -type d -name "*$1*" 2>/dev/null; }

    # bak FILE — timestamped copy beside the original.
    bak() {
        [ -e "$1" ] || { printf 'bak: no such file: %s\n' "$1" >&2; return 1; }
        cp -a "$1" "$1.$(date +%Y%m%d-%H%M%S).bak" && printf '%s.%s.bak\n' "$1" "$(date +%Y%m%d-%H%M%S)"
    }

    # path — $PATH, one entry per line.
    path() { printf '%s\n' "$PATH" | tr ':' '\n'; }

    # serve [PORT] — http server rooted at $PWD.
    serve() {
        hx_p="${1:-8000}"
        if command -v python3 >/dev/null 2>&1; then
            printf 'serving %s on http://localhost:%s\n' "$PWD" "$hx_p"
            python3 -m http.server "$hx_p"
        else
            printf 'serve: needs python3\n' >&2
            return 1
        fi
        unset hx_p
    }

    # extract FILE — one command for every archive format.
    extract() {
        [ -f "$1" ] || { printf 'extract: no such file: %s\n' "$1" >&2; return 1; }
        case "$1" in
            *.tar.bz2|*.tbz2) tar xjf "$1" ;;
            *.tar.gz|*.tgz)   tar xzf "$1" ;;
            *.tar.xz|*.txz)   tar xJf "$1" ;;
            *.tar.zst)        tar --zstd -xf "$1" ;;
            *.tar)            tar xf "$1" ;;
            *.bz2)            bunzip2 "$1" ;;
            *.gz)             gunzip "$1" ;;
            *.xz)             unxz "$1" ;;
            *.zst)            unzstd "$1" ;;
            *.zip)            unzip "$1" ;;
            *.7z)             7z x "$1" ;;
            *.rar)            unrar x "$1" ;;
            *) printf 'extract: unknown format: %s\n' "$1" >&2; return 1 ;;
        esac
    }
fi

# ============================================================================
# 14. INIT
# ============================================================================

# Restore the persisted theme, unless the environment overrode it.
if [ -z "${HX_THEME-}" ] && [ -r "$HX_STATE/theme" ]; then
    read -r HX_THEME < "$HX_STATE/theme" 2>/dev/null
fi
HX_THEME="${HX_THEME:-hellish}"
hx_theme_valid "$HX_THEME" || HX_THEME=hellish

hx_hooks_install

# Top level, deliberately: see the note in hx_hooks_install. This is the one
# statement in the file that cannot be moved into a function.
if [ "$HX_SHELL" = "bash" ]; then
    trap 'hx_preexec' DEBUG 2>/dev/null
fi

[ -r "$HX_PROMPT_CONF" ] || hx_conf_save

# Local overrides, loaded last so they always win. Anything machine-specific
# belongs here rather than in this file.
[ -r "$HX_HOME/local.sh" ] && . "$HX_HOME/local.sh"

[ "$HX_BANNER" = "1" ] && hx_banner

fi

# ============================================================================
# Sourcing must never poison the first prompt's exit status.
# ============================================================================
:
