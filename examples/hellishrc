hx_theme_arrow() {
    hx_c="$HX_fblue"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_forange"
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fmoss$HX_G_BR $HX_GLABEL$HX_r"
    HX_PS1="$HX_fsand$HX_P$HX_r$hx_g$HX_NL$hx_c$HX_G_H$HX_G_H$HX_G_TRI$HX_r "
    HX_RPS1="$HX_dm$HX_DURSTR$HX_r"
}

# --- 10. dots ---------------------------------------------------------------
hx_theme_dots() {
    hx_c="$HX_fgreen"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fred"
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fdark $HX_G_DOT $HX_r$HX_fteal$HX_GLABEL$HX_r"
    HX_PS1="$hx_c$HX_G_DOT$HX_r $HX_fslate$HX_P$HX_r$hx_g $HX_fdark$HX_G_DOT$HX_r "
    HX_RPS1="$HX_fdark$HX_TIME$HX_r"
}

# --- 11. matrix -------------------------------------------------------------
hx_theme_matrix() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fmoss::$HX_facid$HX_GLABEL$HX_r"
    hx_x=''
    [ "$HX_XOK" = "0" ] && hx_x="${HX_fmoss}[$HX_facid$HX_X$HX_fmoss]"
    HX_PS1="${HX_fmoss}[$HX_facid$HX_U$HX_fmoss@$HX_facid$HX_H$HX_fmoss]$HX_r$HX_fgreen$HX_P$HX_r$hx_g$hx_x$HX_NL$HX_facid$HX_G_ARR$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fmoss$HX_TIME$HX_r"
}

# --- 12. neon ---------------------------------------------------------------
hx_theme_neon() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fpink$HX_G_STAR$HX_r$HX_fneon$HX_GLABEL$HX_r"
    hx_c="$HX_fneon"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fcrim"
    HX_PS1="$HX_fpink$HX_G_HALF$HX_fviolet$HX_G_HALF$HX_fneon$HX_G_HALF$HX_r $HX_fsnow$HX_P$HX_r$hx_g$HX_NL$hx_c$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fviolet$HX_TIME$HX_r"
}

# --- 13. rails --------------------------------------------------------------
hx_theme_rails() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fdark$HX_G_H$HX_r$HX_fgold$HX_GLABEL$HX_r"
    HX_PS1="$HX_fsteel$HX_G_TLB$HX_G_H$HX_r$HX_fwhite$HX_P$HX_r$hx_g$HX_NL$HX_fsteel$HX_G_BLB$HX_G_H$HX_G_H$HX_r$HX_fsky$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdark$HX_DURSTR $HX_TIME$HX_r"
}

