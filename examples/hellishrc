# ~/.hellishrc
# ============================================================================
# HELLISH — monolithic interactive shell rc
# ============================================================================
#
# Single-file, self-contained, zero dependencies beyond a POSIX shell.
# Drives the prompt, the context collectors, and a small command suite (`hx`).
#
# Design constraints:
#
#   1. The ENTIRE file is POSIX-parseable. No arrays, no [[ ]], no ${x//a/b}
#      outside of eval, no process substitution. This means dash, bash, zsh
#      and hellish(1) can all parse it top to bottom without a syntax error,
#      even if they cannot execute every branch.
#
#   2. Feature detection is runtime, not compile-time. Everything degrades:
#      no colors -> plain text, no unicode -> ASCII, no git -> no vcs segment,
#      no monotonic clock -> second-resolution timings.
#
#   3. `return` is never used at top level. The whole loader is if/else.
#
#   4. The last statement is `:` so sourcing NEVER poisons $? and therefore
#      never makes the first prompt render a bogus failure marker.
#
#   5. Nothing here forks on a fast path. Rendering a prompt in a warm cache
#      is pure parameter expansion. `hx bench` measures it; keep it honest.
#
# Commands:
#
#       hx                  status card
#       hx theme            theme control (list/set/next/prev/random/demo)
#       hx conf             get/set/list/edit/reset configuration
#       hx doctor           capability + health report
#       hx bench [N]        measure prompt render cost
#       hx segments         dump every collected value, right now
#       hx colors           color ramps for the detected depth
#       hx glyphs           unicode / nerd font test card
#       hx banner           the boot card
#       hx keys             keybindings this shell actually honors
#       hx reload           re-source this file
#       hx help             everything above, documented
#
#   Aliases: `theme` and `prompt` map to `hx theme`.
#
# Config: environment, or ~/.hellish/prompt.conf as plain KEY=VALUE lines.
# (prompt.conf is deliberately NOT hellish.conf — that file belongs to the
#  plugin framework and uses a different grammar. Writing to it would eat
#  the user's `feature <name> on` lines.)
#
#   HX_THEME            theme name                      (default: hellish)
#   HX_COLOR            auto|24|256|8|none              (default: auto)
#   HX_UNICODE          auto|1|0                        (default: auto)
#   HX_NERD             1|0     powerline/branch glyphs (default: 0)
#   HX_GIT              1|0     enable vcs segment      (default: 1)
#   HX_GIT_DEEP         1|0     ahead/behind/stash      (default: 1)
#   HX_PATH_MAX         path components before eliding  (default: 4)
#   HX_PATH_STYLE       full|short|tail|fish            (default: full)
#   HX_DUR_MIN          ms before duration shows        (default: 2000)
#   HX_TITLE            1|0     set terminal title      (default: 1)
#   HX_RPROMPT          1|0     right prompt emulation  (default: 1)
#   HX_ERGONOMICS       1|0     history/keys/aliases    (default: 1)
#   HX_BANNER           1|0     print boot card         (default: 0)
#   HX_CACHE            1|0     per-directory collector cache (default: 1)
#   HX_K8S              1|0     kubernetes segment      (default: 0)
#   HX_CLOUD            1|0     aws/gcp profile segment (default: 0)
#   HX_SYS              1|0     load average + battery  (default: 0)
#
# ============================================================================

# ============================================================================
# 1. SHELL DETECTION + INTERACTIVITY GUARD
# ============================================================================

HX_SHELL=posix
HX_IS_HELLISH=0
if [ -n "${ZSH_VERSION-}" ]; then
    HX_SHELL=zsh
elif [ -n "${BASH_VERSION-}" ]; then
    HX_SHELL=bash
fi

# hellish(1) reports BASH_VERSION for compatibility, so the bash branch is the
# right one to take — but it is NOT bash, and the differences bite:
#
#   * the DEBUG trap fires before PROMPT_COMMAND as well as before the
#     command (bash does too), which silently zeroes a naive preexec timer;
#   * `bind` does not exist;
#   * it has a real RPROMPT and publishes the repository state itself
#     (vcs_info's HELLISH_GIT_* variables), so the prompt needs no git
#     process there -- HX_NATIVE below.
#
# Detect it once, here, and let the rest of the file branch on facts instead
# of guessing. `hx doctor` prints the whole list.
if [ "$HX_SHELL" = "bash" ] && [ -z "${BASH-}" ]; then
    HX_IS_HELLISH=1
fi
case "${0##*/}" in hellish) HX_IS_HELLISH=1 ;; esac

# Interactive check. `case $- in *i*` is the portable form; zsh keeps $- too.
HX_INTERACTIVE=0
case "$-" in
    *i*) HX_INTERACTIVE=1 ;;
esac

if [ "$HX_INTERACTIVE" = "0" ] && [ -z "${HX_FORCE-}" ]; then
    # Non-interactive. Do nothing at all, but do not error.
    :
else

# ============================================================================
# 2. PATHS, CONFIG, STATE
# ============================================================================

HX_HOME="${HX_HOME:-$HOME/.hellish}"
HX_STATE="${HX_STATE:-$HX_HOME/state}"
HX_VERSION="2.0.0"

# NOT $HX_HOME/hellish.conf. That file belongs to the plugin framework
# (`feature <name> on` / `set VAR value`) and rewriting it from here would
# silently delete every plugin the user has enabled.
HX_PROMPT_CONF="${HX_PROMPT_CONF:-$HX_HOME/prompt.conf}"

export HX_HOME HX_STATE HX_PROMPT_CONF

[ -d "$HX_STATE" ] || mkdir -p "$HX_STATE" 2>/dev/null

# --- defaults ---------------------------------------------------------------
HX_COLOR="${HX_COLOR:-auto}"
HX_UNICODE="${HX_UNICODE:-auto}"
HX_NERD="${HX_NERD:-0}"
HX_GIT="${HX_GIT:-1}"
HX_GIT_DEEP="${HX_GIT_DEEP:-1}"
HX_PATH_MAX="${HX_PATH_MAX:-4}"
HX_PATH_STYLE="${HX_PATH_STYLE:-full}"
HX_DUR_MIN="${HX_DUR_MIN:-2000}"
HX_TITLE="${HX_TITLE:-1}"
HX_RPROMPT="${HX_RPROMPT:-1}"
HX_ERGONOMICS="${HX_ERGONOMICS:-1}"
HX_BANNER="${HX_BANNER:-0}"
HX_CACHE="${HX_CACHE:-1}"
HX_K8S="${HX_K8S:-0}"
HX_CLOUD="${HX_CLOUD:-0}"
HX_SYS="${HX_SYS:-0}"

# Every key `hx conf` will accept, read or write. A config file cannot reach
# outside this list, so it can never relocate $HX_HOME or $HX_STATE mid-load.
HX_KEYS="HX_THEME HX_COLOR HX_UNICODE HX_NERD HX_GIT HX_GIT_DEEP
HX_PATH_MAX HX_PATH_STYLE HX_DUR_MIN HX_TITLE HX_RPROMPT
HX_ERGONOMICS HX_BANNER HX_CACHE HX_K8S HX_CLOUD HX_SYS"

# NB: the loop variable is hx_kv, not hx_k. hx_conf_load iterates with hx_k
# and calls this function from inside that loop; sharing the name let the
# callee's `unset` blank the caller's key, and every config line was then
# eval'd as `=value`, i.e. "command not found" on every startup. There are no
# locals here, so distinct names are the only defence.
hx_key_valid() {
    for hx_kv in $HX_KEYS; do
        [ "$hx_kv" = "$1" ] && { unset hx_kv; return 0; }
    done
    unset hx_kv
    return 1
}

# Deliberately dumb parser: KEY=VALUE, one per line, # comments, no quoting
# games, no eval of arbitrary shell. Only whitelisted keys are assigned.
hx_conf_load() {
    [ -r "$HX_PROMPT_CONF" ] || return 0
    while IFS= read -r hx_line; do
        case "$hx_line" in
            ''|\#*) continue ;;
            *=*) : ;;
            *) continue ;;
        esac
        hx_k="${hx_line%%=*}"
        hx_v="${hx_line#*=}"
        if hx_key_valid "$hx_k"; then
            eval "$hx_k=\$hx_v"
        fi
    done < "$HX_PROMPT_CONF"
    unset hx_line hx_k hx_v
}

hx_conf_save() {
    [ -d "$HX_HOME" ] || mkdir -p "$HX_HOME" 2>/dev/null || return 1
    {
        printf '# %s\n' "${HX_PROMPT_CONF##*/} - written by hellishrc $HX_VERSION"
        printf '# Prompt configuration only. Plugin state lives in hellish.conf.\n'
        for hx_k in $HX_KEYS; do
            eval "hx_v=\${$hx_k-}"
            printf '%s=%s\n' "$hx_k" "$hx_v"
        done
    } > "$HX_PROMPT_CONF" || return 1
    unset hx_k hx_v
    return 0
}

hx_conf_load

# ============================================================================
# 3. CAPABILITY DETECTION
# ============================================================================

hx_has() { command -v "$1" >/dev/null 2>&1; }

# --- color depth ------------------------------------------------------------
if [ "$HX_COLOR" = "auto" ]; then
    if [ -n "${NO_COLOR-}" ]; then
        HX_COLOR=none
    elif [ "${TERM-}" = "dumb" ] || [ -z "${TERM-}" ]; then
        HX_COLOR=none
    else
        case "${COLORTERM-}" in
            truecolor|24bit) HX_COLOR=24 ;;
            *)
                hx_n=8
                hx_has tput && hx_n=$(tput colors 2>/dev/null || echo 8)
                case "$hx_n" in
                    ''|*[!0-9]*) hx_n=8 ;;
                esac
                if [ "$hx_n" -ge 256 ]; then HX_COLOR=256; else HX_COLOR=8; fi
                unset hx_n
                ;;
        esac
    fi
fi

# --- unicode ----------------------------------------------------------------
if [ "$HX_UNICODE" = "auto" ]; then
    case "${LC_ALL-}${LC_CTYPE-}${LANG-}" in
        *[Uu][Tt][Ff]*) HX_UNICODE=1 ;;
        *) HX_UNICODE=0 ;;
    esac
fi

# --- monotonic-ish clock ----------------------------------------------------
# Resolution, best first:
#   1. /proc/uptime      10ms, and NO FORK - just a builtin read
#   2. $EPOCHREALTIME    1us  (zsh, bash 5)
#   3. date '+%s %N'     1ms  but two forks per prompt
#   4. $EPOCHSECONDS     1s
#   5. date +%s          1s   and a fork
#
# Note: `date +%s%3N` is NOT used. uutils-coreutils date ignores the field
# width and emits full nanoseconds, which produces a 19-digit garbage number
# that silently breaks every duration. Learned the hard way.
HX_CLOCK=seconds
if [ -r /proc/uptime ]; then
    HX_CLOCK=uptime
elif [ -n "${EPOCHREALTIME-}" ]; then
    HX_CLOCK=epochreal
elif [ -n "${EPOCHSECONDS-}" ]; then
    HX_CLOCK=epochsec
fi

# --- terminal width ---------------------------------------------------------
# hellish never sets COLUMNS, so cache `tput cols` and refresh it on SIGWINCH
# rather than forking tput on every prompt.
HX_COLS=80
hx_cols_refresh() {
    if [ -n "${COLUMNS-}" ] && [ "$COLUMNS" -gt 0 ] 2>/dev/null; then
        HX_COLS="$COLUMNS"
    elif hx_has tput; then
        HX_COLS=$(tput cols 2>/dev/null || echo 80)
    fi
    case "$HX_COLS" in
        ''|*[!0-9]*|0) HX_COLS=80 ;;
    esac
}
hx_cols_refresh
trap 'hx_cols_refresh' WINCH 2>/dev/null

# --- what the shell can do for the prompt itself -----------------------------
# Detected once, here, and never by forking.
#
# HX_NATIVE  hellish's vcs_info builtin also publishes the repository state
#            as HELLISH_GIT_* variables, from a background `git status` the
#            shell caches and refreshes on its own. With it, the git segment
#            costs the prompt no process at all -- see hx_git_collect. The
#            probe is the variables themselves: an older hellish has
#            vcs_info but sets none of them, and keeps the portable path.
#            RPROMPT is the same shell's native right prompt.
# HX_PRINTF_T  printf -v VAR '%(fmt)T' works (bash >= 4.2, hellish): the
#            clock without a `date` fork.
# HX_FUNSUB  bash >= 5.3's ${ cmd; } runs a builtin without a subshell.
HX_NATIVE=0
if [ "$HX_IS_HELLISH" = "1" ] && command -v vcs_info >/dev/null 2>&1; then
    vcs_info >/dev/null 2>&1
    [ -n "${HELLISH_GIT_AHEAD+x}" ] && HX_NATIVE=1
fi
# The `?` flag needs the untracked walk, which the shell only does when asked.
[ "$HX_NATIVE" = "1" ] && HELLISH_VCS_UNTRACKED=1
HX_PRINTF_T=0
if [ "$HX_SHELL" = "bash" ] && printf -v hx_t '%(%s)T' -1 2>/dev/null \
        && [ -n "${hx_t-}" ]; then
    HX_PRINTF_T=1
fi
HX_FUNSUB=0
if [ "$HX_SHELL" = "bash" ] && [ "$HX_IS_HELLISH" = "0" ] \
        && eval 'hx_t=${ printf ok; }' 2>/dev/null && [ "$hx_t" = "ok" ]; then
    HX_FUNSUB=1
fi
unset hx_t
HX_HAVE_GIT=0
command -v git >/dev/null 2>&1 && HX_HAVE_GIT=1

# --- prompt-escape wrapping -------------------------------------------------
# Non-printing sequences must be marked or the shell miscomputes line width
# and wrecks multiline editing / history recall.
#
#   zsh   %{ ... %}
#   bash  \001 ... \002   (raw bytes, since we build PS1 dynamically)
#   other nothing
HX_WS=''
HX_WE=''
if [ "$HX_SHELL" = "zsh" ]; then
    HX_WS='%{'
    HX_WE='%}'
elif [ "$HX_SHELL" = "bash" ]; then
    HX_WS=$(printf '\001')
    HX_WE=$(printf '\002')
fi

# ============================================================================
# 4. COLOR ENGINE
# ============================================================================
#
# Escapes are computed ONCE at load into plain variables. Rendering a prompt
# is then pure string concatenation: no subshells, no forks, no measurable
# cost per keystroke.

HX_ESC=$(printf '\033')

# 256-index -> ANSI 30..37 fallback, so 8-color terminals still get sane hues.
hx_basic8() {
    case "$1" in
        16|232|233|234|235|236|237|238|239|240) echo 30 ;;
        1|9|52|88|124|160|196|197|203|204|210)  echo 31 ;;
        2|10|22|28|34|40|46|76|82|114|118|154)  echo 32 ;;
        3|11|136|172|178|180|184|214|220|222|223) echo 33 ;;
        4|12|17|19|25|27|33|39|67|69|75|111)    echo 34 ;;
        5|13|54|90|93|127|129|135|141|176|177|212|213) echo 35 ;;
        6|14|30|37|44|45|50|51|80|86|87|116)    echo 36 ;;
        *) echo 37 ;;
    esac
}

# hx_esc <38|48> <256-index>
hx_esc() {
    case "$HX_COLOR" in
        none) return 0 ;;
        8)
            hx_b8=$(hx_basic8 "$2")
            [ "$1" = "48" ] && hx_b8=$((hx_b8 + 10))
            printf '%s\033[%sm%s' "$HX_WS" "$hx_b8" "$HX_WE"
            ;;
        *)
            printf '%s\033[%s;5;%sm%s' "$HX_WS" "$1" "$2" "$HX_WE"
            ;;
    esac
}

hx_sgr() {
    [ "$HX_COLOR" = "none" ] && return 0
    printf '%s\033[%sm%s' "$HX_WS" "$1" "$HX_WE"
}

# hx_palette: fill HX_f* (foreground) and HX_b* (background) + attributes.
hx_palette() {
    HX_r=$(hx_sgr 0)
    HX_bd=$(hx_sgr 1)
    HX_dm=$(hx_sgr 2)
    HX_it=$(hx_sgr 3)
    HX_ul=$(hx_sgr 4)
    HX_rv=$(hx_sgr 7)

    for hx_spec in \
        fblack:236 fgrey:244 fdark:240 fslate:246 fwhite:252 fsnow:255 \
        fred:203 fblood:160 fcrim:197 fpink:212 forange:209 fsand:223 \
        fyellow:180 fgold:214 flime:154 facid:118 fgreen:114 fmoss:71 \
        fteal:44 fcyan:80 fneon:51 fsky:117 fblue:75 fsteel:67 fdeep:33 \
        fviolet:141 fpurple:135 fmagenta:176 fmauve:183 \
        bblack:236 bgrey:240 bred:160 bgreen:29 byellow:136 bblue:25 \
        bmagenta:90 bcyan:30 bwhite:250 bviolet:54 borange:130 bsteel:60
    do
        hx_n="${hx_spec%%:*}"
        hx_c="${hx_spec#*:}"
        case "$hx_n" in
            f*) eval "HX_$hx_n=\$(hx_esc 38 $hx_c)" ;;
            b*) eval "HX_$hx_n=\$(hx_esc 48 $hx_c)" ;;
        esac
    done
    unset hx_spec hx_n hx_c
}
hx_palette

# ============================================================================
# 5. GLYPHS
# ============================================================================

if [ "$HX_UNICODE" = "1" ]; then
    HX_G_TL='╭'; HX_G_BL='╰'; HX_G_V='│'; HX_G_H='─'
    HX_G_ARR='❯'; HX_G_LAM='λ'; HX_G_OK='✓'; HX_G_BAD='✘'
    HX_G_BR='⎇'; HX_G_ELL='…'; HX_G_DOT='•'; HX_G_STAR='★'
    HX_G_PL='▶'; HX_G_PLT='❯'; HX_G_UP='↑'; HX_G_DN='↓'
    HX_G_STASH='⚑'; HX_G_LOCK='⚿'; HX_G_BOLT='⚡'; HX_G_CLK='⏱'
    HX_G_TLB='┌'; HX_G_BLB='└'; HX_G_TR='╮'; HX_G_HASH='#'
    HX_G_DIAM='◆'; HX_G_SQ='▪'; HX_G_TRI='▸'; HX_G_HALF='▓'
    HX_G_CLOUD='☁'; HX_G_HELM='⎈'; HX_G_BOX='▣'; HX_G_PLUG='⌁'
else
    HX_G_TL='.'; HX_G_BL='`'; HX_G_V='|'; HX_G_H='-'
    HX_G_ARR='>'; HX_G_LAM='\\'; HX_G_OK='+'; HX_G_BAD='x'
    HX_G_BR='git'; HX_G_ELL='..'; HX_G_DOT='*'; HX_G_STAR='*'
    HX_G_PL='>'; HX_G_PLT='>'; HX_G_UP='^'; HX_G_DN='v'
    HX_G_STASH='$'; HX_G_LOCK='#'; HX_G_BOLT='!'; HX_G_CLK='@'
    HX_G_TLB='+'; HX_G_BLB='+'; HX_G_TR='+'; HX_G_HASH='#'
    HX_G_DIAM='<>'; HX_G_SQ='#'; HX_G_TRI='>'; HX_G_HALF='#'
    HX_G_CLOUD='c'; HX_G_HELM='k'; HX_G_BOX='[]'; HX_G_PLUG='~'
fi

# Nerd Font glyphs (U+E0B0 U+E0B1 U+E0A0). Off by default: they render as
# tofu without a patched font. Enable with HX_NERD=1 or `hx conf set HX_NERD 1`.
# Written as octal escapes so this file stays 7-bit clean and survives any
# copy/paste, editor or terminal that would otherwise eat private-use chars.
if [ "$HX_NERD" = "1" ] && [ "$HX_UNICODE" = "1" ]; then
    HX_G_PL=$(printf '\356\202\260')
    HX_G_PLT=$(printf '\356\202\261')
    HX_G_BR=$(printf '\356\202\240')
fi

HX_NL='
'

# ============================================================================
# 6. UTILITIES
# ============================================================================

# Escape % so zsh prompt expansion cannot be hijacked by a path or branch
# name containing a percent sign. This is a real bug in most dotfiles.
hx_pct() {
    if [ "$HX_SHELL" = "zsh" ]; then
        eval 'HX_RET=${1//\%/%%}'
    else
        HX_RET="$1"
    fi
}

# hx_strip <string> -> HX_RET with every SGR sequence and prompt-escape
# marker removed. Pure parameter expansion, no fork. ESC, '[', the numeric
# parameters and the final letter are all 7-bit ASCII, so this is safe even
# where ${x#?} slices bytes rather than characters.
hx_strip() {
    hx_s="$1"
    hx_o=''
    while :; do
        case "$hx_s" in
            *"$HX_ESC"*) : ;;
            *) hx_o="$hx_o$hx_s"; break ;;
        esac
        hx_o="$hx_o${hx_s%%"$HX_ESC"*}"
        hx_s="${hx_s#*"$HX_ESC"}"
        hx_s="${hx_s#\[}"
        while [ -n "$hx_s" ]; do
            hx_c="${hx_s%"${hx_s#?}"}"
            hx_s="${hx_s#?}"
            case "$hx_c" in
                [a-zA-Z]) break ;;
            esac
        done
    done
    HX_RET="$hx_o"
    unset hx_s hx_c
    # Drop the \001/\002 width markers too; they occupy no columns. A span
    # at a time, like the escapes above: the old loop took one character
    # per iteration, which is quadratic in the prompt's length.
    if [ -n "${HX_WS:-}" ]; then
        HX_RET=''
        while :; do
            case "$hx_o" in
                *"$HX_WS"*|*"$HX_WE"*) : ;;
                *) HX_RET="$HX_RET$hx_o"; break ;;
            esac
            hx_c="${hx_o%%["$HX_WS$HX_WE"]*}"
            HX_RET="$HX_RET$hx_c"
            hx_o="${hx_o#"$hx_c"?}"
        done
    fi
    unset hx_o hx_c
}

# hx_vwidth <string> -> HX_W, the column count of <string> once decorated.
#
# ${#s} counts CHARACTERS in bash and zsh but BYTES in hellish, so a UTF-8
# glyph is over-counted there. That only ever makes the estimate too large,
# which nudges a right-aligned string a couple of columns further left -
# never off the edge, never a wrap. A theme that cares can set HX_RPW itself.
hx_vwidth() {
    hx_strip "$1"
    HX_W="${#HX_RET}"
}

# hx_repeat <char> <n> -> HX_RET
hx_repeat() {
    hx_rr=''
    hx_ri=0
    while [ "$hx_ri" -lt "$2" ]; do
        hx_rr="$hx_rr$1"
        hx_ri=$((hx_ri + 1))
    done
    HX_RET="$hx_rr"
    unset hx_rr hx_ri
}

# hx_dur <milliseconds> -> human string in HX_RET
hx_dur() {
    hx_ms=$1
    if [ "$hx_ms" -lt 1000 ]; then
        HX_RET="${hx_ms}ms"
    elif [ "$hx_ms" -lt 60000 ]; then
        HX_RET="$((hx_ms / 1000)).$(( (hx_ms % 1000) / 100 ))s"
    elif [ "$hx_ms" -lt 3600000 ]; then
        HX_RET="$((hx_ms / 60000))m$(( (hx_ms % 60000) / 1000 ))s"
    else
        HX_RET="$((hx_ms / 3600000))h$(( (hx_ms % 3600000) / 60000 ))m"
    fi
    unset hx_ms
}

# hx_ms10 <total-ms> <iterations> -> HX_RET as "12.3 ms", one decimal.
# Integer arithmetic only; there is no float type in a POSIX shell.
hx_ms10() {
    hx_t=$(( $1 * 10 / $2 ))
    HX_RET="$((hx_t / 10)).$((hx_t % 10)) ms"
    unset hx_t
}

# hx_shorten <path> -> HX_RET, honoring HX_PATH_STYLE / HX_PATH_MAX
hx_shorten() {
    hx_p="$1"
    case "$hx_p" in
        "$HOME") hx_p='~' ;;
        "$HOME"/*) hx_p="~${hx_p#"$HOME"}" ;;
    esac

    case "$HX_PATH_STYLE" in
        tail)
            case "$hx_p" in
                */*) hx_p="${hx_p##*/}" ;;
            esac
            ;;
        fish|short)
            # ~/dev/projects/hellish -> ~/d/p/hellish
            hx_out=''
            hx_rest="$hx_p"
            hx_last="${hx_p##*/}"
            [ "$hx_last" = "$hx_p" ] && hx_last=''
            while [ -n "$hx_rest" ]; do
                hx_seg="${hx_rest%%/*}"
                case "$hx_rest" in
                    */*) hx_rest="${hx_rest#*/}" ;;
                    *) hx_rest='' ;;
                esac
                if [ -z "$hx_rest" ] && [ -n "$hx_last" ]; then
                    hx_out="$hx_out/$hx_seg"
                elif [ -z "$hx_seg" ]; then
                    :
                else
                    case "$hx_seg" in
                        .?*) hx_out="$hx_out/$(printf '%.2s' "$hx_seg")" ;;
                        *)   hx_out="$hx_out/$(printf '%.1s' "$hx_seg")" ;;
                    esac
                fi
            done
            hx_p="${hx_out#/}"
            case "$1" in
                /*) [ "${hx_p#\~}" = "$hx_p" ] && hx_p="/$hx_p" ;;
            esac
            unset hx_out hx_rest hx_seg hx_last
            ;;
        *)
            # full, but elide the middle past HX_PATH_MAX components
            hx_cnt=0
            hx_tmp="$hx_p"
            while [ -n "$hx_tmp" ]; do
                case "$hx_tmp" in
                    */*) hx_tmp="${hx_tmp#*/}"; hx_cnt=$((hx_cnt + 1)) ;;
                    *) hx_tmp=''; hx_cnt=$((hx_cnt + 1)) ;;
                esac
            done
            if [ "$hx_cnt" -gt "$HX_PATH_MAX" ]; then
                hx_drop=$((hx_cnt - HX_PATH_MAX))
                hx_tmp="$hx_p"
                while [ "$hx_drop" -gt 0 ]; do
                    hx_tmp="${hx_tmp#*/}"
                    hx_drop=$((hx_drop - 1))
                done
                hx_p="$HX_G_ELL/$hx_tmp"
            fi
            unset hx_cnt hx_tmp hx_drop
            ;;
    esac

    HX_RET="$hx_p"
    unset hx_p
}

# ============================================================================
# 7. CLOCK
# ============================================================================
#
# hx_now_ms -> HX_RET, milliseconds. Whatever the source, the value is only
# ever compared against another reading from the same source, so an arbitrary
# epoch (as /proc/uptime has) is fine.
hx_now_ms() {
    case "$HX_CLOCK" in
        uptime)
            read -r hx_up hx_idle < /proc/uptime 2>/dev/null || hx_up=0
            hx_sec="${hx_up%%.*}"
            hx_frac="${hx_up#*.}"
            case "$hx_up" in
                *.*) : ;;
                *) hx_frac=00 ;;
            esac
            # Two centisecond digits, without forking printf: pad, then
            # subtract the tail. Strip the leading zero or `07` is octal.
            hx_frac="${hx_frac}00"
            hx_idle="${hx_frac#??}"
            hx_frac="${hx_frac%"$hx_idle"}"
            case "$hx_frac" in 0?) hx_frac="${hx_frac#0}" ;; esac
            case "$hx_sec$hx_frac" in
                ''|*[!0-9]*) HX_RET=0 ;;
                *) HX_RET=$(( hx_sec * 1000 + hx_frac * 10 )) ;;
            esac
            unset hx_up hx_idle hx_sec hx_frac
            ;;
        epochreal)
            eval 'HX_RET=$(( ${EPOCHREALTIME%%.*} * 1000 + ${EPOCHREALTIME#*.} / 1000 ))' \
                2>/dev/null || HX_RET=0
            ;;
        epochsec)
            HX_RET=$(( ${EPOCHSECONDS:-0} * 1000 ))
            ;;
        *)
            HX_RET=$(($(date +%s 2>/dev/null || echo 0) * 1000))
            ;;
    esac
}

# ============================================================================
# 8. CONTEXT COLLECTORS
# ============================================================================
#
# Rules every collector obeys:
#   * it sets its outputs to a known-empty value FIRST, so a bail-out can
#     never leave a stale segment on screen;
#   * it is wrapped so a missing or broken tool can never break a prompt;
#   * anything that costs a fork is either gated behind a config flag or
#     served from the cache in section 9.

# --- git --------------------------------------------------------------------
# One question, asked the cheapest way the shell allows:
#
#   hellish   vcs_info fills HELLISH_GIT_* from the shell's own background
#             scan. No process is started, so a held Enter key or a `cd`
#             into a large repository never waits for git.
#   others    ONE `git status --porcelain=v2 --branch --show-stash`, and
#             none at all outside a repository (found by walking up for
#             .git, no fork). It says everything the segment shows: branch
#             or commit, ahead/behind, stash, and each kind of change.
#
# The collector this replaces ran git seven times per prompt, and its
# `git diff --quiet` walked into every submodule: 77 ms per prompt in a
# repository with ten of them, half a second when the files were not in
# the page cache. `--ignore-submodules=dirty` is what zsh's vcs_info passes:
# a submodule whose recorded commit moved still shows.
hx_git_collect() {
    HX_GB=''; HX_GF=''; HX_GA=0; HX_GBH=0; HX_GS=0; HX_GST=''
    HX_GDIRTY=0; HX_GREPO=''; HX_GWT=0

    [ "$HX_GIT" = "1" ] || return 0
    if [ "$HX_NATIVE" = "1" ]; then
        hx_git_native
    else
        hx_git_portable
    fi
    [ -n "$HX_GF" ] && HX_GDIRTY=1
    if [ "$HX_GIT_DEEP" != "1" ]; then
        HX_GA=0; HX_GBH=0; HX_GS=0
    fi
    hx_pct "$HX_GB"; HX_GB="$HX_RET"
    :
}

hx_git_native() {
    vcs_info
    [ -n "$HELLISH_GIT_BRANCH" ] || return 0
    HX_GB="$HELLISH_GIT_BRANCH"
    [ "$HELLISH_GIT_DETACHED" = "1" ] && HX_GB="$HX_G_DIAM$HX_GB"
    HX_GREPO="${HELLISH_GIT_ROOT##*/}"
    [ "$HELLISH_GIT_STAGED" = "1" ] && HX_GF="${HX_GF}+"
    [ "$HELLISH_GIT_UNSTAGED" = "1" ] && HX_GF="${HX_GF}~"
    [ "$HELLISH_GIT_UNTRACKED" = "1" ] && HX_GF="${HX_GF}?"
    [ "$HELLISH_GIT_UNMERGED" = "1" ] && HX_GF="${HX_GF}!"
    HX_GA="$HELLISH_GIT_AHEAD"
    HX_GBH="$HELLISH_GIT_BEHIND"
    HX_GS="$HELLISH_GIT_STASH"
    hx_git_state "$HELLISH_GIT_DIR"
}

# hx_git_root -> HX_GROOT / HX_GDIR for $PWD, or status 1 outside a repo.
# Pure file tests, cached per directory: the walk runs once per `cd`.
HX_GROOT_PWD=''
HX_GROOT=''
HX_GDIR=''
hx_git_root() {
    if [ "$HX_GROOT_PWD" != "$PWD" ]; then
        HX_GROOT_PWD="$PWD"
        HX_GROOT=''
        HX_GDIR=''
        hx_d="$PWD"
        while :; do
            if [ -e "$hx_d/.git" ]; then
                HX_GROOT="${hx_d:-/}"
                break
            fi
            case "$hx_d" in */*) : ;; *) break ;; esac
            hx_d="${hx_d%/*}"
            [ -n "$hx_d" ] || { [ -e "/.git" ] && HX_GROOT=/; break; }
        done
        unset hx_d
        [ -n "$HX_GROOT" ] && hx_git_dir
    fi
    [ -n "$HX_GROOT" ]
}

# The git dir of HX_GROOT: .git itself, or what a `gitdir:` file names
# (submodules, linked worktrees), relative to the root when relative.
hx_git_dir() {
    HX_GDIR="$HX_GROOT/.git"
    [ -f "$HX_GDIR" ] || return 0
    hx_line=''
    read -r hx_line < "$HX_GDIR"
    case "$hx_line" in
        'gitdir: /'*) HX_GDIR="${hx_line#gitdir: }" ;;
        'gitdir: '*)  HX_GDIR="$HX_GROOT/${hx_line#gitdir: }" ;;
    esac
    unset hx_line
}

hx_git_portable() {
    [ "$HX_HAVE_GIT" = "1" ] || return 0
    hx_git_root || return 0
    # Check the OUTPUT, not just the status. `alias g=git` followed by a
    # `g() { ... }` definition silently defines a function named git - in
    # bash, zsh, dash and hellish alike - which prints nothing and returns
    # 0. Without a branch header there is no segment.
    hx_gi=$(git --no-optional-locks status --porcelain=v2 --branch \
        --show-stash --ignore-submodules=dirty -unormal 2>/dev/null)
    hx_oid=''; hx_st=0; hx_un=0; hx_ut=0; hx_um=0
    while IFS= read -r hx_l; do
        case "$hx_l" in
            '# branch.oid '*)  hx_oid="${hx_l#\# branch.oid }" ;;
            '# branch.head '*) HX_GB="${hx_l#\# branch.head }" ;;
            '# branch.ab +'*)
                hx_l="${hx_l#\# branch.ab +}"
                HX_GA="${hx_l%% *}"
                HX_GBH="${hx_l##*-}" ;;
            '# stash '*)       HX_GS="${hx_l#\# stash }" ;;
            [12]' '[!.][!.]*)  hx_st=1; hx_un=1 ;;
            [12]' '[!.]*)      hx_st=1 ;;
            [12]' '?[!.]*)     hx_un=1 ;;
            'u '*)             hx_st=1; hx_un=1; hx_um=1 ;;
            '? '*)             hx_ut=1 ;;
        esac
        # Headers come first; once every flag is known the rest is noise.
        [ "$hx_st$hx_un$hx_ut$hx_um" = "1111" ] && break
    done <<HX_EOF
$hx_gi
HX_EOF
    if [ "$HX_GB" = "(detached)" ]; then
        HX_GB="$HX_G_DIAM${hx_oid%"${hx_oid#???????}"}"
    fi
    if [ -n "$HX_GB" ]; then
        HX_GREPO="${HX_GROOT##*/}"
        [ "$hx_st" = "1" ] && HX_GF="${HX_GF}+"
        [ "$hx_un" = "1" ] && HX_GF="${HX_GF}~"
        [ "$hx_ut" = "1" ] && HX_GF="${HX_GF}?"
        [ "$hx_um" = "1" ] && HX_GF="${HX_GF}!"
        case "$HX_GA$HX_GBH$HX_GS" in *[!0-9]*) HX_GA=0; HX_GBH=0; HX_GS=0 ;; esac
        hx_git_state "$HX_GDIR"
    fi
    unset hx_gi hx_l hx_oid hx_st hx_un hx_ut hx_um
}

# In-progress operation and worktree-ness, from the git dir. File tests only.
hx_git_state() {
    [ -n "$1" ] || return 0
    if [ -d "$1/rebase-merge" ] || [ -d "$1/rebase-apply" ]; then
        HX_GST='rebase'
    elif [ -f "$1/MERGE_HEAD" ]; then
        HX_GST='merge'
    elif [ -f "$1/CHERRY_PICK_HEAD" ]; then
        HX_GST='cherry'
    elif [ -f "$1/REVERT_HEAD" ]; then
        HX_GST='revert'
    elif [ -f "$1/BISECT_LOG" ]; then
        HX_GST='bisect'
    fi
    # A linked worktree's git-dir lives under the main repo's worktrees/.
    case "$1" in
        */worktrees/*) HX_GWT=1 ;;
    esac
    :
}

# Composed git label used by most themes: main+~ ↑2 ↓1 ⚑3 (merge)
hx_git_label() {
    HX_GLABEL=''
    [ -n "$HX_GB" ] || return 0
    HX_GLABEL="$HX_GB$HX_GF"
    [ "$HX_GA"  -gt 0 ] 2>/dev/null && HX_GLABEL="$HX_GLABEL $HX_G_UP$HX_GA"
    [ "$HX_GBH" -gt 0 ] 2>/dev/null && HX_GLABEL="$HX_GLABEL $HX_G_DN$HX_GBH"
    [ "$HX_GS"  -gt 0 ] 2>/dev/null && HX_GLABEL="$HX_GLABEL $HX_G_STASH$HX_GS"
    [ "$HX_GWT" = "1" ] && HX_GLABEL="$HX_GLABEL $HX_G_BOX"
    [ -n "$HX_GST" ] && HX_GLABEL="$HX_GLABEL ($HX_GST)"
    :
}

# --- language / toolchain ---------------------------------------------------
# Only probe when a marker file sits in $PWD, and only run the version command
# for the ONE toolchain that matched. At most one fork, usually zero.
hx_env_collect() {
    HX_VENV=''
    [ -n "${VIRTUAL_ENV-}" ] && HX_VENV="${VIRTUAL_ENV##*/}"
    [ -n "${CONDA_DEFAULT_ENV-}" ] && HX_VENV="${CONDA_DEFAULT_ENV}"
    [ -n "${IN_NIX_SHELL-}" ] && HX_VENV="nix:${IN_NIX_SHELL}"
    [ -n "$HX_VENV" ] && { hx_pct "$HX_VENV"; HX_VENV="$HX_RET"; }

    HX_LANG=''
    if [ -f package.json ]; then
        if [ -f bun.lockb ] && hx_has bun; then
            HX_LANG="bun $(bun --version 2>/dev/null)"
        elif hx_has node; then
            HX_LANG="node $(node -v 2>/dev/null)"
        fi
    elif [ -f deno.json ] || [ -f deno.jsonc ]; then
        hx_has deno && HX_LANG="deno $(deno --version 2>/dev/null | head -1 | cut -d' ' -f2)"
    elif [ -f Cargo.toml ] && hx_has rustc; then
        HX_LANG="rust $(rustc --version 2>/dev/null | cut -d' ' -f2)"
    elif [ -f go.mod ] && hx_has go; then
        HX_LANG="go $(go env GOVERSION 2>/dev/null)"
    elif { [ -f pyproject.toml ] || [ -f requirements.txt ] || [ -f setup.py ]; } && hx_has python3; then
        HX_LANG="py $(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)"
    elif [ -f Gemfile ] && hx_has ruby; then
        HX_LANG="rb $(ruby -e 'print RUBY_VERSION' 2>/dev/null)"
    elif [ -f composer.json ] && hx_has php; then
        HX_LANG="php $(php -r 'echo PHP_VERSION;' 2>/dev/null)"
    elif { [ -f pom.xml ] || [ -f build.gradle ] || [ -f build.gradle.kts ]; }; then
        HX_LANG="jvm"
    elif [ -f build.zig ] && hx_has zig; then
        HX_LANG="zig $(zig version 2>/dev/null)"
    elif [ -f mix.exs ]; then
        HX_LANG="elixir"
    elif [ -f Dockerfile ] || [ -f compose.yaml ] || [ -f docker-compose.yml ]; then
        HX_LANG="docker"
    elif [ -f Makefile ] || [ -f makefile ] || [ -f GNUmakefile ]; then
        HX_LANG="make"
    fi
    :
}

# --- kubernetes -------------------------------------------------------------
# `kubectl config current-context` costs ~100ms; far too slow for a prompt.
# Read the kubeconfig directly instead: the current context is a single
# top-level `current-context:` key, so a bounded grep finds it.
hx_k8s_collect() {
    HX_KCTX=''
    [ "$HX_K8S" = "1" ] || return 0
    hx_kc="${KUBECONFIG:-$HOME/.kube/config}"
    case "$hx_kc" in *:*) hx_kc="${hx_kc%%:*}" ;; esac
    [ -r "$hx_kc" ] || { unset hx_kc; return 0; }
    while IFS= read -r hx_line; do
        case "$hx_line" in
            current-context:*)
                HX_KCTX="${hx_line#current-context:}"
                HX_KCTX="${HX_KCTX# }"
                HX_KCTX="${HX_KCTX%\"}"
                HX_KCTX="${HX_KCTX#\"}"
                break
                ;;
        esac
    done < "$hx_kc"
    [ -n "${HX_KNS-}" ] && HX_KCTX="$HX_KCTX/$HX_KNS"
    [ -n "$HX_KCTX" ] && { hx_pct "$HX_KCTX"; HX_KCTX="$HX_RET"; }
    unset hx_kc hx_line
}

# --- cloud profile ----------------------------------------------------------
hx_cloud_collect() {
    HX_CLOUDP=''
    [ "$HX_CLOUD" = "1" ] || return 0
    if [ -n "${AWS_PROFILE-}" ]; then
        HX_CLOUDP="aws:$AWS_PROFILE"
    elif [ -n "${AWS_VAULT-}" ]; then
        HX_CLOUDP="aws:$AWS_VAULT"
    elif [ -n "${CLOUDSDK_ACTIVE_CONFIG_NAME-}" ]; then
        HX_CLOUDP="gcp:$CLOUDSDK_ACTIVE_CONFIG_NAME"
    elif [ -n "${AZURE_CONFIG_DIR-}" ]; then
        HX_CLOUDP="az"
    fi
    [ -n "$HX_CLOUDP" ] && { hx_pct "$HX_CLOUDP"; HX_CLOUDP="$HX_RET"; }
    :
}

# --- where am I really running ----------------------------------------------
# All file tests and variable reads. No forks, so this is safe every prompt.
hx_where_collect() {
    HX_CTR=''
    if [ -f /.dockerenv ]; then
        HX_CTR=docker
    elif [ -f /run/.containerenv ]; then
        HX_CTR=podman
    elif [ -n "${container-}" ]; then
        HX_CTR="$container"
    elif [ -n "${SINGULARITY_NAME-}" ]; then
        HX_CTR=singularity
    fi
    [ -n "${debian_chroot-}" ] && HX_CTR="chroot:$debian_chroot"

    HX_MUX=''
    if [ -n "${TMUX-}" ]; then
        HX_MUX=tmux
    elif [ -n "${STY-}" ]; then
        HX_MUX=screen
    elif [ -n "${ZELLIJ-}" ]; then
        HX_MUX=zellij
    fi

    HX_SSHF=0
    { [ -n "${SSH_CONNECTION-}" ] || [ -n "${SSH_TTY-}" ]; } && HX_SSHF=1
    :
}

# --- system health ----------------------------------------------------------
# Off by default. Both readings come from sysfs/procfs, so no forks either.
hx_sys_collect() {
    HX_LOAD=''; HX_BAT=''; HX_BATST=''
    [ "$HX_SYS" = "1" ] || return 0

    if [ -r /proc/loadavg ]; then
        read -r hx_l1 hx_l5 hx_l15 hx_rest < /proc/loadavg 2>/dev/null
        HX_LOAD="$hx_l1"
        unset hx_l1 hx_l5 hx_l15 hx_rest
    fi

    for hx_b in /sys/class/power_supply/BAT0 /sys/class/power_supply/BAT1; do
        if [ -r "$hx_b/capacity" ]; then
            read -r HX_BAT < "$hx_b/capacity" 2>/dev/null
            [ -r "$hx_b/status" ] && read -r HX_BATST < "$hx_b/status" 2>/dev/null
            break
        fi
    done
    unset hx_b
    :
}

# --- identity, jobs, clocks -------------------------------------------------
# $USER/$HOSTNAME are read once at load; they cannot change mid-session and
# `id -un` / `hostname` are forks nobody should pay for on every prompt.
HX_U="${USER:-${LOGNAME:-$(id -un 2>/dev/null || echo user)}}"
HX_H="${HOSTNAME:-$(hostname 2>/dev/null || echo localhost)}"
HX_H="${HX_H%%.*}"
HX_ROOT=0
HX_PRIV='$'
if [ "$(id -u 2>/dev/null || echo 1000)" = "0" ]; then
    HX_PRIV='#'
    HX_ROOT=1
fi

# Exit statuses worth naming. 128+n is the shell's encoding of "killed by
# signal n", and `✘ 139` is much less useful than `✘ SIGSEGV`.
hx_signame() {
    case "$1" in
        126) HX_RET='NOEXEC' ;;
        127) HX_RET='NOTFOUND' ;;
        129) HX_RET='SIGHUP'  ;; 130) HX_RET='SIGINT'  ;;
        131) HX_RET='SIGQUIT' ;; 132) HX_RET='SIGILL'  ;;
        134) HX_RET='SIGABRT' ;; 136) HX_RET='SIGFPE'  ;;
        137) HX_RET='SIGKILL' ;; 139) HX_RET='SIGSEGV' ;;
        141) HX_RET='SIGPIPE' ;; 143) HX_RET='SIGTERM' ;;
        *)   HX_RET='' ;;
    esac
}

hx_misc_collect() {
    # The job count: hellish runs `$(jobs)` in-process and bash >= 5.3 has
    # ${ ...; } for it; other shells pay one subshell. The clock never
    # forks where the shell can tell the time itself: printf's %(fmt)T on
    # bash and hellish, zsh's %D prompt escape. date(1) is for dash.
    if [ "$HX_FUNSUB" = "1" ]; then
        eval 'hx_j=${ jobs; }'
    else
        hx_j=$(jobs)
    fi
    HX_JOBS=0
    while [ -n "$hx_j" ]; do
        HX_JOBS=$((HX_JOBS + 1))
        case "$hx_j" in
            *"$HX_NL"*) hx_j="${hx_j#*"$HX_NL"}" ;;
            *) hx_j='' ;;
        esac
    done

    if [ "$HX_PRINTF_T" = "1" ]; then
        printf -v HX_TIME '%(%H:%M:%S)T' -1
        printf -v HX_DATE '%(%d %b)T' -1
    elif [ "$HX_SHELL" = "zsh" ]; then
        eval 'HX_TIME=${(%):-%D{%H:%M:%S}}; HX_DATE=${(%):-%D{%d %b}}'
    else
        hx_d=$(date '+%H:%M:%S|%d %b' 2>/dev/null)
        HX_TIME="${hx_d%%|*}"
        HX_DATE="${hx_d#*|}"
    fi
    unset hx_j hx_d
    :
}

# ============================================================================
# 9. CACHE
# ============================================================================
#
# Only values that cannot change without leaving the directory are cached
# here. Dirty state, ahead/behind and stash counts are NOT: a command that
# edits a file must be reflected by the very next prompt. (Under hellish the
# shell caches them itself, and throws the answer away whenever a command
# could have touched the tree -- see hx_git_collect.)
#
# What this removes is the toolchain probe - `node -v` and `rustc --version`
# are 30-60ms forks, paid on every prompt in every project directory. Keyed
# on $PWD, they are paid once per directory instead.
#
# The kubeconfig is keyed on its own mtime with `-nt`, which is a shell
# builtin test, so refresh detection itself costs nothing.

HX_CSTAMP="$HX_STATE/.cache-stamp"
HX_CPWD=''
HX_CLANG=''
HX_CVENV=''
HX_CKCTX=''
HX_CKCONF=''

hx_cache_stamp() {
    # `: >file` updates mtime without forking touch(1).
    : > "$HX_CSTAMP" 2>/dev/null
}

hx_cached_collect() {
    if [ "$HX_CACHE" != "1" ]; then
        hx_env_collect
        hx_k8s_collect
        return 0
    fi

    if [ "$HX_CPWD" = "$PWD" ]; then
        HX_LANG="$HX_CLANG"
        HX_VENV="$HX_CVENV"
    else
        hx_env_collect
        HX_CPWD="$PWD"
        HX_CLANG="$HX_LANG"
        HX_CVENV="$HX_VENV"
    fi

    # A virtualenv can be activated without changing directory, so re-read
    # the (fork-free) environment part every time and let it win.
    if [ -n "${VIRTUAL_ENV-}${CONDA_DEFAULT_ENV-}${IN_NIX_SHELL-}" ]; then
        HX_VENV="${VIRTUAL_ENV##*/}"
        [ -n "${CONDA_DEFAULT_ENV-}" ] && HX_VENV="$CONDA_DEFAULT_ENV"
        [ -n "${IN_NIX_SHELL-}" ] && HX_VENV="nix:$IN_NIX_SHELL"
    else
        HX_VENV=''
    fi
    HX_CVENV="$HX_VENV"

    if [ "$HX_K8S" = "1" ]; then
        hx_kc="${KUBECONFIG:-$HOME/.kube/config}"
        case "$hx_kc" in *:*) hx_kc="${hx_kc%%:*}" ;; esac
        if [ "$hx_kc" != "$HX_CKCONF" ] || [ "$hx_kc" -nt "$HX_CSTAMP" ]; then
            hx_k8s_collect
            HX_CKCTX="$HX_KCTX"
            HX_CKCONF="$hx_kc"
            hx_cache_stamp
        else
            HX_KCTX="$HX_CKCTX"
        fi
        unset hx_kc
    else
        HX_KCTX=''
    fi
    :
}

# `hx cache drop` and every `cd`-invalidating command route through this.
hx_cache_drop() {
    HX_CPWD=''; HX_CLANG=''; HX_CVENV=''; HX_CKCTX=''; HX_CKCONF=''
    :
}

# ============================================================================
# 10. THEMES
# ============================================================================
#
# Contract for every theme function:
#
#   INPUT  (globals, already escaped and safe to interpolate)
#     HX_X        last exit code            HX_XOK    1 if success
#     HX_XSIG     signal name for 128+n     HX_P      display path
#     HX_U/HX_H   user / host               HX_PRIV   $ or #
#     HX_GLABEL   git label ('' if none)    HX_GDIRTY 1 if worktree dirty
#     HX_GB/HX_GF branch / flag chars       HX_GREPO  repository name
#     HX_GA/HX_GBH/HX_GS  ahead/behind/stash counts
#     HX_GST      merge|rebase|cherry|revert|bisect
#     HX_VENV     virtualenv name           HX_LANG   toolchain hint
#     HX_KCTX     kubernetes context        HX_CLOUDP aws/gcp profile
#     HX_CTR      container/chroot          HX_MUX    tmux/screen/zellij
#     HX_LOAD     1-min load average        HX_BAT    battery percent
#     HX_TIME     HH:MM:SS                  HX_DATE   dd Mon
#     HX_DURSTR   command duration          HX_JOBS   background job count
#     HX_SSHF     1 if over ssh             HX_ROOT   1 if uid 0
#     HX_NL       newline
#
#   OUTPUT
#     HX_PS1      left prompt
#     HX_RPS1     right prompt (emulated everywhere; see section 11)
#
# Every theme must be legible with HX_COLOR=none. `hx demo` renders all of
# them against live data, which is the only way to check that claim.

HX_THEMES="hellish minimal pure powerline agnoster lambda classic bracket
arrow dots matrix neon rails compact zen dev boxed ascii hex night ocean
sunset mono gitfocus kernel ops status cyber pill quantum"
# --- 1. hellish: the canonical three-line box -------------------------------
hx_theme_hellish() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="${HX_fyellow}[git: $HX_GLABEL]$HX_r"
    hx_x=''
    [ "$HX_XOK" = "0" ] && hx_x="$HX_fred$HX_G_BAD $HX_X$HX_r "
    hx_v=''
    [ -n "$HX_VENV" ] && hx_v="$HX_fviolet($HX_VENV)$HX_r "
    HX_PS1="$HX_fblue$HX_G_TL$HX_G_H$HX_r $HX_fcyan$HX_U$HX_r$HX_fdark@$HX_r$HX_fgrey$HX_H$HX_r $HX_fdark in$HX_r $HX_fmagenta$HX_P$HX_r$HX_NL"
    HX_PS1="$HX_PS1$HX_fblue$HX_G_V$HX_r  $hx_v$hx_g $hx_x$HX_dm$HX_DURSTR$HX_r$HX_NL"
    HX_PS1="$HX_PS1$HX_fblue$HX_G_BL$HX_G_H$HX_r $HX_fyellow$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdark$HX_TIME$HX_r"
}

# --- 2. minimal -------------------------------------------------------------
hx_theme_minimal() {
    hx_c="$HX_fgreen"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fred"
    HX_PS1="$hx_c$HX_G_ARR$HX_r "
    HX_RPS1=''
}

# --- 3. pure: two-line, muted, sindresorhus-ish -----------------------------
hx_theme_pure() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fdark$HX_GLABEL$HX_r"
    hx_c="$HX_fviolet"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fred"
    HX_PS1="$HX_fblue$HX_P$HX_r$hx_g $HX_dm$HX_DURSTR$HX_r$HX_NL$hx_c$HX_G_ARR$HX_r "
    HX_RPS1=''
}

# --- 4. powerline -----------------------------------------------------------
hx_theme_powerline() {
    hx_s=""
    hx_s="$hx_s$HX_bblue$HX_fsnow $HX_U "
    if [ -n "$HX_GLABEL" ]; then
        hx_s="$hx_s$HX_bmagenta$HX_fblue$HX_G_PL$HX_fsnow $HX_P "
        if [ "$HX_GDIRTY" = "1" ]; then
            hx_s="$hx_s$HX_byellow$HX_fmagenta$HX_G_PL$HX_fblack $HX_GLABEL "
            hx_s="$hx_s$HX_r$HX_fyellow$HX_G_PL$HX_r "
        else
            hx_s="$hx_s$HX_bgreen$HX_fmagenta$HX_G_PL$HX_fsnow $HX_GLABEL "
            hx_s="$hx_s$HX_r$HX_fgreen$HX_G_PL$HX_r "
        fi
    else
        hx_s="$hx_s$HX_bmagenta$HX_fblue$HX_G_PL$HX_fsnow $HX_P "
        hx_s="$hx_s$HX_r$HX_fmagenta$HX_G_PL$HX_r "
    fi
    [ "$HX_XOK" = "0" ] && hx_s="$HX_bred$HX_fsnow $HX_X $HX_r$HX_fred$HX_G_PL$HX_r $hx_s"
    HX_PS1="$hx_s"
    HX_RPS1="$HX_fdark$HX_TIME$HX_r"
}

# --- 5. agnoster (single line, no bg fills) ---------------------------------
hx_theme_agnoster() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fdark$HX_G_PLT$HX_r $HX_fgreen$HX_G_BR $HX_GLABEL$HX_r"
    [ "$HX_GDIRTY" = "1" ] && hx_g=" $HX_fdark$HX_G_PLT$HX_r $HX_fyellow$HX_G_BR $HX_GLABEL$HX_r"
    hx_c="$HX_fcyan"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fred"
    HX_PS1="$HX_fsteel$HX_U$HX_r $HX_fdark$HX_G_PLT$HX_r $HX_fsky$HX_P$HX_r$hx_g $hx_c$HX_G_PL$HX_r "
    HX_RPS1="$HX_fdark$HX_JOBS jobs$HX_r"
}

# --- 6. lambda --------------------------------------------------------------
hx_theme_lambda() {
    hx_c="$HX_facid"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fcrim"
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fdark:$HX_r$HX_fteal$HX_GLABEL$HX_r"
    HX_PS1="$hx_c$HX_G_LAM$HX_r $HX_fwhite$HX_P$HX_r$hx_g $hx_c$HX_G_ARR$HX_r "
    HX_RPS1=''
}

# --- 7. classic sh ----------------------------------------------------------
hx_theme_classic() {
    HX_PS1="$HX_fgreen$HX_U@$HX_H$HX_r:$HX_fblue$HX_P$HX_r$HX_PRIV "
    HX_RPS1=''
}

# --- 8. bracket -------------------------------------------------------------
hx_theme_bracket() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fyellow($HX_GLABEL)$HX_r"
    hx_x=''
    [ "$HX_XOK" = "0" ] && hx_x="${HX_fred}[$HX_X]$HX_r"
    HX_PS1="$hx_x${HX_fgrey}[$HX_r$HX_fcyan$HX_U$HX_r $HX_fwhite$HX_P$HX_r$hx_g$HX_fgrey]$HX_r$HX_PRIV "
    HX_RPS1="$HX_fdark$HX_DATE $HX_TIME$HX_r"
