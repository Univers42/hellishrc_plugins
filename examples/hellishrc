hx_theme_compact() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fdark:$HX_fgreen${HX_GB}${HX_GF}$HX_r"
    hx_c="$HX_fsnow"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fred"
    HX_PS1="$HX_fblue${HX_P##*/}$HX_r$hx_g $hx_c$HX_G_ARR$HX_r "
    HX_RPS1=''
}

# --- 15. zen ----------------------------------------------------------------
hx_theme_zen() {
    hx_c="$HX_fslate"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fsand"
    HX_PS1="$HX_NL$hx_c  $HX_G_DIAM$HX_r  "
    HX_RPS1="$HX_fblack$HX_P$HX_r"
}

# --- 16. dev: toolchain-aware -----------------------------------------------
hx_theme_dev() {
    hx_l=''
    [ -n "$HX_LANG" ] && hx_l="${HX_fdark}[$HX_r$HX_forange$HX_LANG$HX_r$HX_fdark]$HX_r "
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="${HX_fdark}[$HX_r$HX_fgreen$HX_GLABEL$HX_r$HX_fdark]$HX_r "
    hx_v=''
    [ -n "$HX_VENV" ] && hx_v="$HX_fviolet($HX_VENV)$HX_r "
    hx_x=''
    [ "$HX_XOK" = "0" ] && hx_x="$HX_fred$HX_G_BAD$HX_X$HX_r "
    HX_PS1="$hx_v$HX_fcyan$HX_P$HX_r $hx_g$hx_l$hx_x$HX_NL$HX_fsteel$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdark$HX_DURSTR$HX_r"
}

# --- 17. boxed --------------------------------------------------------------
hx_theme_boxed() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_G_V $HX_fgold$HX_GLABEL$HX_r"
    HX_PS1="$HX_fdark$HX_G_TLB$HX_G_H$HX_r $HX_fwhite$HX_U@$HX_H$HX_r $HX_G_V $HX_fsky$HX_P$HX_r$hx_g$HX_NL"
    HX_PS1="$HX_PS1$HX_fdark$HX_G_BLB$HX_G_H$HX_r$HX_fgreen$HX_PRIV$HX_r "
    HX_RPS1="$HX_fdark$HX_TIME$HX_r"
}

# --- 18. ascii (safe everywhere, no unicode, no color needed) ---------------
hx_theme_ascii() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" ($HX_GLABEL)"
    hx_x=''
    [ "$HX_XOK" = "0" ] && hx_x=" [$HX_X]"
    HX_PS1="$HX_U@$HX_H $HX_P$hx_g$hx_x$HX_PRIV "
    HX_RPS1=''
}

# --- 19. hex ----------------------------------------------------------------
hx_theme_hex() {
    # Braces are load-bearing. Without them the name runs on into the "0x0"
    # that follows and the shell looks up a variable that does not exist, so
    # the marker rendered as nothing. test/prompt.hsh checks for this class.
    hx_x="${HX_fmoss}0x0"
    [ "$HX_XOK" = "0" ] && hx_x="${HX_fcrim}0x$HX_X"
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fdark<$HX_r$HX_fteal$HX_GLABEL$HX_r$HX_fdark>$HX_r"
    HX_PS1="$hx_x$HX_r $HX_fdark|$HX_r $HX_fslate$HX_P$HX_r$hx_g $HX_fteal$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdark$HX_TIME$HX_r"
}

# --- 20. night --------------------------------------------------------------
hx_theme_night() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fdark on $HX_r$HX_fmauve$HX_GLABEL$HX_r"
    hx_c="$HX_fmauve"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fpink"
    HX_PS1="$HX_fdeep$HX_G_SQ$HX_r $HX_fslate$HX_P$HX_r $hx_g$HX_NL$hx_c$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fblack$HX_DATE$HX_r"
}

# --- 21. ocean --------------------------------------------------------------
hx_theme_ocean() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g=" $HX_fteal$HX_G_BR $HX_GLABEL$HX_r"
    HX_PS1="$HX_fdeep$HX_G_H$HX_G_H$HX_r$HX_fsky $HX_P$HX_r$hx_g $HX_fteal$HX_G_H$HX_G_H$HX_r$HX_NL$HX_fcyan$HX_G_ARR$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdeep$HX_TIME$HX_r"
}

# --- 22. sunset -------------------------------------------------------------
hx_theme_sunset() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fsand $HX_GLABEL$HX_r"
    hx_c="$HX_forange"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fblood"
    HX_PS1="$HX_fgold$HX_G_HALF$HX_forange$HX_G_HALF$HX_fcrim$HX_G_HALF$HX_r $HX_fsand$HX_P$HX_r $hx_g$HX_NL$hx_c$HX_G_TRI$HX_r "
    HX_RPS1="$HX_fdark$HX_DURSTR$HX_r"
}

# --- 23. mono ---------------------------------------------------------------
hx_theme_mono() {
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fdark ($HX_GLABEL)$HX_r"
    hx_x=''
    [ "$HX_XOK" = "0" ] && hx_x="$HX_bd!$HX_r"
    HX_PS1="$HX_fwhite$HX_P$HX_r$hx_g $hx_x$HX_fgrey$HX_G_ARR$HX_r "
    HX_RPS1=''
}

# --- 24. gitfocus -----------------------------------------------------------
hx_theme_gitfocus() {
    if [ -n "$HX_GB" ]; then
        hx_c="$HX_fgreen"
        [ "$HX_GDIRTY" = "1" ] && hx_c="$HX_fyellow"
        [ -n "$HX_GST" ] && hx_c="$HX_fcrim"
        HX_PS1="$hx_c$HX_G_BR $HX_GB$HX_r"
        [ -n "$HX_GF" ] && HX_PS1="$HX_PS1 $HX_forange$HX_GF$HX_r"
        [ "$HX_GA"  -gt 0 ] 2>/dev/null && HX_PS1="$HX_PS1 $HX_fsky$HX_G_UP$HX_GA$HX_r"
        [ "$HX_GBH" -gt 0 ] 2>/dev/null && HX_PS1="$HX_PS1 $HX_fpink$HX_G_DN$HX_GBH$HX_r"
        [ "$HX_GS"  -gt 0 ] 2>/dev/null && HX_PS1="$HX_PS1 $HX_fviolet$HX_G_STASH$HX_GS$HX_r"
        [ -n "$HX_GST" ] && HX_PS1="$HX_PS1 $HX_fcrim$HX_GST$HX_r"
        HX_PS1="$HX_PS1 $HX_fdark$HX_G_V$HX_r $HX_fslate$HX_P$HX_r$HX_NL"
    else
        HX_PS1="$HX_fdark(no repo)$HX_r $HX_fslate$HX_P$HX_r$HX_NL"
    fi
    HX_PS1="$HX_PS1$HX_fgreen$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdark$HX_TIME$HX_r"
}

# --- 25. kernel -------------------------------------------------------------
hx_theme_kernel() {
    hx_ok="$HX_fgreen$HX_G_OK"
    [ "$HX_XOK" = "0" ] && hx_ok="$HX_fred$HX_G_BAD $HX_X"
    hx_s=''
    [ "$HX_SSHF" = "1" ] && hx_s="${HX_forange}[ssh]$HX_r "
    [ "$HX_ROOT" = "1" ] && hx_s="$hx_s${HX_fcrim}[root]$HX_r "
    hx_j=''
    [ "$HX_JOBS" -gt 0 ] 2>/dev/null && hx_j="${HX_fviolet}[$HX_JOBS&]$HX_r "
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fgold$HX_GLABEL$HX_r "
    HX_PS1="${HX_fdark}[$hx_ok$HX_fdark]$HX_r $hx_s$hx_j$HX_fsteel$HX_U$HX_r$HX_fdark:$HX_r$HX_fsnow$HX_P$HX_r $hx_g$HX_NL$HX_fsteel$HX_PRIV$HX_r "
    HX_RPS1="$HX_fdark$HX_DURSTR $HX_TIME$HX_r"
}

# --- 26. ops: the one you want when the blast radius is not your laptop -----
hx_theme_ops() {
    hx_w=''
    [ "$HX_SSHF" = "1" ] && hx_w="$hx_w$HX_bblue$HX_fsnow ssh $HX_r"
    [ -n "$HX_CTR" ]     && hx_w="$hx_w$HX_bsteel$HX_fsnow $HX_CTR $HX_r"
    [ "$HX_ROOT" = "1" ] && hx_w="$hx_w$HX_bred$HX_fsnow root $HX_r"
    [ -n "$hx_w" ] && hx_w="$hx_w "
    hx_k=''
    [ -n "$HX_KCTX" ]   && hx_k="$HX_fteal$HX_G_HELM $HX_KCTX$HX_r "
    [ -n "$HX_CLOUDP" ] && hx_k="$hx_k$HX_forange$HX_G_CLOUD $HX_CLOUDP$HX_r "
    hx_g=''
    [ -n "$HX_GLABEL" ] && hx_g="$HX_fgreen$HX_G_BR $HX_GLABEL$HX_r "
    [ "$HX_GDIRTY" = "1" ] && hx_g="$HX_fyellow$HX_G_BR $HX_GLABEL$HX_r "
    hx_c="$HX_fteal"
    [ "$HX_XOK" = "0" ] && hx_c="$HX_fcrim"
    HX_PS1="$hx_w$hx_k$HX_fsky$HX_P$HX_r $hx_g$HX_NL$hx_c$HX_G_ARR$HX_r "
    HX_RPS1="$HX_fdark$HX_DURSTR $HX_TIME$HX_r"
}

# --- 27. status: a full-width status line, everything visible at once -------
hx_theme_status() {
    hx_x="$HX_fgreen$HX_G_OK$HX_r"
    if [ "$HX_XOK" = "0" ]; then
        hx_x="$HX_fcrim$HX_G_BAD $HX_X$HX_r"
        [ -n "$HX_XSIG" ] && hx_x="$HX_fcrim$HX_G_BAD $HX_XSIG$HX_r"
    fi
    hx_s=''
    [ -n "$HX_VENV" ]  && hx_s="$hx_s$HX_fviolet$HX_VENV$HX_r $HX_fdark$HX_G_V$HX_r "
    [ -n "$HX_LANG" ]  && hx_s="$hx_s$HX_forange$HX_LANG$HX_r $HX_fdark$HX_G_V$HX_r "
    [ -n "$HX_KCTX" ]  && hx_s="$hx_s$HX_fteal$HX_KCTX$HX_r $HX_fdark$HX_G_V$HX_r "
    [ -n "$HX_MUX" ]   && hx_s="$hx_s$HX_fslate$HX_MUX$HX_r $HX_fdark$HX_G_V$HX_r "
    [ "$HX_JOBS" -gt 0 ] 2>/dev/null && hx_s="$hx_s$HX_fpink${HX_JOBS}&$HX_r $HX_fdark$HX_G_V$HX_r "
    [ -n "$HX_LOAD" ]  && hx_s="$hx_s$HX_fsand$HX_LOAD$HX_r $HX_fdark$HX_G_V$HX_r "
    hx_g="$HX_fdark(no repo)$HX_r"
