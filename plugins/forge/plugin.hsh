# plugins/forge/plugin.hsh — THE OFFICIAL PLUGIN.
#
# forge is the reference implementation of the plugin contract, and the tool
# that writes new plugins for you. If you want to know how to build a plugin,
# read this file: it uses every part of the API it documents.
#
#   forge new <name>     scaffold a plugin that already passes forge lint
#   forge lint [name]    check a plugin against the contract
#   forge doc [name]     generate markdown documentation from the registry
#   forge list           plugins on disk, with their file sizes
#   forge api            the plugin API, explained with examples
hx_plugin forge on core "forge (official): scaffold, lint and document plugins" || return 0

forge() {
    local cmd="${1:-help}"
    [ $# -gt 0 ] && shift
    case "$cmd" in
        new)   forge_new "$@" ;;
        lint)  forge_lint "$@" ;;
        doc)   forge_doc "$@" ;;
        list)  forge_list ;;
        api)   forge_api ;;
        help|-h|--help) forge_help ;;
        *) hx_err "forge: unknown command '$cmd'"; forge_help; return 2 ;;
    esac
}
hx_func_doc forge "scaffold, lint and document plugins" "forge new|lint|doc|list|api <name>"

forge_help() {
    hx_head "forge — the official plugin toolkit"
    hx_kv "forge new <name>"  "scaffold a new plugin that already passes lint"
    hx_kv "forge lint [name]" "check one plugin, or every plugin, against the contract"
    hx_kv "forge doc [name]"  "generate markdown docs from the registry"
    hx_kv "forge list"        "plugins on disk"
    hx_kv "forge api"         "the plugin API with examples"
    printf '\n'
}

forge_list() {
    local d name size
    hx_head "plugins on disk"
    for d in "$HX_PLUGIN_DIR"/*/; do
        [ -r "$d/plugin.hsh" ] || continue
        name="${d%/}"; name="${name##*/}"
        size=$(wc -l < "$d/plugin.hsh" | tr -d ' ')
        printf '  '
        hx_badge "${HX_FEAT_STATE[$name]:-off}"
        printf ' %s%-22s%s %4s lines  %s\n' "$HX_B" "$name" "$HX_R" "$size" "${HX_PLUG_DESC[$name]:-}"
    done
    printf '\n'
}

# ── forge new ───────────────────────────────────────────────────────────────
forge_new() {
    local name="$1" dir desc
    [ -n "$name" ] || { hx_err "usage: forge new <name>"; return 2; }
    case "$name" in
        *[!a-z0-9_-]*) hx_err "plugin names: lowercase letters, digits, _ and - only"; return 2 ;;
    esac
    dir="$HX_PLUGIN_DIR/$name"
    [ -e "$dir" ] && { hx_err "already exists: ${dir/#$HOME/\~}"; return 1; }
    desc="${2:-what $name does, in one line}"

    mkdir -p "$dir" || return 1
    # The scaffold is deliberately a WORKING plugin, not a stub with TODOs:
    # you can enable it immediately and it does something real.
    cat > "$dir/plugin.hsh" <<FORGE_TEMPLATE
# plugins/$name/plugin.hsh
#
# Generated by \`forge new $name\`. See \`forge api\` for the full contract.
#
# The first line MUST be hx_plugin ... || return 0 -- it registers the plugin as
# a toggleable feature and returns non-zero when the user has switched it off,
# so everything below is skipped at no cost.
hx_plugin $name off dev "$desc" || return 0

# Declare external commands you need. Never fails the load; missing commands
# show up in \`hxp doctor\`.
# hx_needs curl jq

# Private helpers are prefixed _${name}_ so they cannot collide with another
# plugin. Only the public names below should be un-prefixed.
_${name}_greet() {
    printf 'hello from the %s plugin\n' "$name"
}

# Document every public function. \`declare -F\` can list functions on a recent
# hellish, but it cannot tell anyone what yours is FOR -- the description, the
# usage line and the owning module exist only because you registered them, and
# that is what help_conf and \`hxp info\` print.
${name}_hello() {
    _${name}_greet
}
hx_func_doc ${name}_hello "say hello (replace me with something useful)"

# Completion. On a hellish with \`complete\` this installs immediately and
# reaches TAB; on an older one it is recorded and installed the day you
# upgrade. Either way you write the same line.
hx_complete ${name}_hello

# Run something before each prompt:
# _${name}_precmd() { :; }
# hx_precmd_add _${name}_precmd
FORGE_TEMPLATE

    cat > "$dir/README.md" <<FORGE_README
# $name

$desc

## Enable

\`\`\`sh
conf on $name && conf reload
\`\`\`

## Provides

| kind | name | description |
|------|------|-------------|
| func | \`${name}_hello\` | say hello |

Generated by \`forge new\`. Run \`forge doc $name\` to regenerate this table
from the live registry once you have added your own functions.
FORGE_README

    hx_ok "created ${dir/#$HOME/\~}"
    printf '  %s%s%s\n' "$HX_GRY" "plugin.hsh   the plugin (already passes forge lint)" "$HX_R"
    printf '  %s%s%s\n' "$HX_GRY" "README.md    regenerate with: forge doc $name" "$HX_R"
    printf '\n  next: %sconf on %s && conf reload%s\n\n' "$HX_B" "$name" "$HX_R"
}

# ── forge lint ──────────────────────────────────────────────────────────────
# Checks the contract, plus the interpreter landmines that silently break a
# plugin ON THE HELLISH YOU ARE RUNNING. Every rule earned its place by
# actually biting, and every one is now gated on hx_cap, so a rule that fires
# is a gap you really do have to code around rather than folklore.
forge_lint() {
    local target="${1:-}" d name rc=0
    if [ -n "$target" ]; then
        _forge_lint_one "$HX_PLUGIN_DIR/$target" || rc=1
    else
        for d in "$HX_PLUGIN_DIR"/*/; do
            [ -r "$d/plugin.hsh" ] || continue
            _forge_lint_one "${d%/}" || rc=1
        done
    fi
    return $rc
}

_forge_lint_one() {
    local dir="$1" f name issues=0 src
    name="${dir##*/}"
    f="$dir/plugin.hsh"
    [ -r "$f" ] || { hx_err "no plugin.hsh in ${dir/#$HOME/\~}"; return 1; }

    # Lint the CODE only. Two things are stripped first:
    #   * comment lines — a landmine quoted in a comment is documentation
    #   * this linter's own rule lines — otherwise forge fails itself, because
    #     every pattern it searches for appears literally in its own source,
    #     as does every example in the message that explains it
    #
    # _forge_gap has to be in this list for the same reason as the other
    # three, and leaving it out is exactly the bug it was added to catch:
    # `_forge_gapw procsub '<\('` contains a process substitution, and
    # `_forge_gap nameref 'local -n'` contains a nameref.
    src=$(grep -v '^[[:space:]]*#' "$f" \
        | grep -v '_forge_fail\|_forge_warn\|_forge_has\|_forge_gap')

    _forge_fail() { printf '  %s%-8s%s %s\n' "$HX_RED" "fail" "$HX_R" "$1"; issues=$((issues + 1)); }
    _forge_warn() { printf '  %s%-8s%s %s\n' "$HX_YEL" "warn" "$HX_R" "$1"; }
    _forge_has()  { printf '%s\n' "$src" | grep -qE "$1"; }

    hx_head "lint: $name"

    # 1. the contract
    grep -q '^hx_plugin ' "$f"            || _forge_fail "missing 'hx_plugin <name> <default> <group> <desc>' declaration"
    grep -q '^hx_plugin .*|| return 0' "$f" || _forge_fail "the hx_plugin line must end with '|| return 0'"
    grep -q "^hx_plugin $name " "$f"      || _forge_fail "hx_plugin name does not match the directory name '$name'"

    # 2. interpreter landmines — CHECKED AGAINST THE RUNNING BINARY
    #
    # These rules used to be unconditional, and by hellish 2.10 every one of
    # them was wrong: `function name {`, `&>`, `local -n`, `printf '\e'`,
    # `${arr[@]:-x}`, `printf %q`, `[ -v x ]` and subscripted writes from a
    # sourced function ALL work now. A linter that keeps failing plugins for
    # using them is not protecting anyone; it is training people to ignore it.
    #
    # So each rule now asks hx_cap first and fires only where the gap is real
    # on the hellish you are running. `conf caps` prints the verdicts. A rule
    # that fires here is a rule you genuinely have to code around.
    _forge_gap() {                      # _forge_gap <cap> <pattern> <message>
        hx_cap "$1" && return 0         # capability present: rule retired
        _forge_has "$2" && _forge_fail "$3"
        return 0
    }
    _forge_gapw() {
        hx_cap "$1" && return 0
        _forge_has "$2" && _forge_warn "$3"
        return 0
    }

    _forge_gap  nameref       'local -n' \
        "'local -n' namerefs yield the NAME, not the value, on this hellish"
    _forge_gap  printf_e      'printf.*\\e\[' \
        "printf does not understand backslash-e on this hellish; use backslash-033"
    _forge_gapw assoc_sourced '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*\[\$' \
        "subscripted write with a variable index breaks when sourced; use hx_aset"
    _forge_gapw printf_q      '%q' \
        "printf '%q' is unsupported on this hellish; use the quote() shim"
    _forge_gapw test_v        '\[[[:space:]]+-v[[:space:]]' \
        "'[ -v VAR ]' always returns false on this hellish; use is_set"
    _forge_gapw nullglob_array '=\([^)]*\*' \
        "a=(glob*) yields the pattern on no match on this hellish; use glob_into"
    _forge_gapw procsub       '<\(' \
        "process substitution needs /dev/fd, which this hellish lacks"

    # extglob is the one gap that is still real AND still lies: `shopt -s
    # extglob` is accepted and `shopt extglob` reports "on", but the operators
    # are a lexer error, so the file does not parse at all.
    _forge_gap  extglob       '[?*+@!]\([^)]*\|' \
        "@() +() ?() pattern operators are a lexer error on this hellish"

    # 2b. prompt rules — a plugin that sets PS1 has two ways to fail silently
    if _forge_has '^[[:space:]]*(PS1|PROMPT|RPROMPT)='; then
        _forge_has '(PS1|PROMPT|RPROMPT)=.*\$\(' && \
            _forge_fail "command substitution is never expanded in a prompt; compute into a variable from a precmd hook"
        _forge_has '(PS1|PROMPT|RPROMPT)="' && \
            _forge_warn "a double-quoted prompt freezes \$? and \$VAR at assignment; single-quote it"
    fi
    _forge_has '^[[:space:]]*PS2=' && \
        _forge_warn "setting PS2 does nothing: hellish's continuation prompt is fixed at '> '"

    # 3. the safety-alias hazard: rc.d/30-aliases.hsh defines rm/mv/cp with -i,
    #    and those aliases are live when this file is PARSED, so an unguarded
    #    call inside a function blocks on a prompt the user never sees.
    _forge_has '(^[[:space:]]*|[;&|][[:space:]]*|&&[[:space:]]*)(rm|mv|cp)[[:space:]]' && \
        ! _forge_has 'command (rm|mv|cp)' && \
        _forge_fail "calls rm/mv/cp unguarded; use 'command rm' etc (the -i aliases leak in)"

    # 4. hygiene
    _forge_has 'hx_func_doc|hx_alias_doc|hx_cmd_doc' || \
        _forge_warn "nothing is documented; help_conf cannot show this plugin's contents"
    [ -r "$dir/README.md" ] || _forge_warn "no README.md (forge doc $name writes one)"

    # 5. does it actually parse? `hellish -n` is a real syntax check (it reports
    #    file:line and sets status 2 without executing), so this is a hard fail.
    #    The binary is whichever hellish is running this -- not /usr/bin, which
    #    a user-mode (42) install does not have.
    local hsh; hsh="$(hx_shell_bin)"
    "$hsh" -n "$f" >/dev/null 2>&1 </dev/null || \
        _forge_fail "does not parse: $("$hsh" -n "$f" 2>&1 </dev/null | head -1)"

    if [ "$issues" -eq 0 ]; then
        printf '  %s%-8s%s contract satisfied\n\n' "$HX_GRN" "pass" "$HX_R"
        return 0
    fi
    printf '\n  %s%s issue(s)%s\n\n' "$HX_RED" "$issues" "$HX_R"
    return 1
}

# ── forge doc ───────────────────────────────────────────────────────────────
# Regenerates a plugin's README table from the LIVE registry, so documentation
# cannot drift from what the plugin actually declares.
forge_doc() {
    local name="${1:-}" key kind out
    [ -n "$name" ] || { hx_err "usage: forge doc <name>"; return 2; }
    hx_known "$name" || { hx_err "plugin '$name' is not loaded (conf on $name && conf reload)"; return 1; }
    out="$HX_PLUGIN_DIR/$name/README.md"

    {
        printf '# %s\n\n%s\n\n' "$name" "${HX_PLUG_DESC[$name]:-}"
        printf '**Group:** %s  \n' "${HX_PLUG_GROUP[$name]:-?}"
        printf '**State:** %s  \n' "${HX_FEAT_STATE[$name]:-off}"
        [ -n "${HX_PLUG_NEEDS[$name]:-}" ] && printf '**Requires:** `%s`  \n' "${HX_PLUG_NEEDS[$name]}"
        printf '\n## Enable\n\n```sh\nconf on %s && conf reload\n```\n\n' "$name"
        printf '## Provides\n\n| kind | name | usage | description |\n|---|---|---|---|\n'
        for key in $(hx_item_keys_sorted); do
            [ "${HX_ITEM_OWNER[$key]:-}" = "$name" ] || continue
            kind="${HX_ITEM_KIND[$key]}"
            [ "$kind" = "plugin" ] && continue
            printf '| %s | `%s` | %s | %s |\n' \
                "$kind" "${key#*:}" \
                "$([ -n "${HX_ITEM_USAGE[$key]}" ] && printf '`%s`' "${HX_ITEM_USAGE[$key]}" || printf '-')" \
                "${HX_ITEM_DESC[$key]}"
        done
        printf '\n---\nGenerated by `forge doc %s`.\n' "$name"
    } > "$out"
    hx_ok "wrote ${out/#$HOME/\~}"
}

# ── forge api ───────────────────────────────────────────────────────────────
forge_api() {
    hx_head "the plugin API"
    printf '
  %sA plugin is%s  ~/.hellish/plugins/<name>/plugin.hsh

  %sFirst line, always:%s
      hx_plugin <name> <on|off> <group> "<one-line description>" || return 0

  %sRegistering what you provide%s  (mandatory: hellish cannot introspect
  functions, so anything unregistered is invisible to help_conf)
      hx_func_doc  <name> "<description>" ["<usage>"]
      hx_alias_doc <name> "<description>"
      hx_var_doc   <NAME> "<description>"
      hx_cmd_doc   <name> "<description>" ["<usage>"]

  %sDependencies%s
      hx_needs curl jq          declare them; never fatal
      hx_have curl              guard a single optional command

  %sHooks%s
      hx_hook_add precmd <fn>   run before every prompt (composable)
      hx_hook_add preexec <fn>  run before each typed line; \$1 is the line
      hx_precmd_add <fn>        the older spelling of the first one

  %sCompletion%s
      hx_complete <cmd> <word>...   declared now, installed when hellish
                                    grows a `complete` builtin

  %sSafe array writes%s  (a subscripted write from a sourced function was
  parsed as a command before hellish 2.8; hx_aset is the portable spelling)
      hx_aset <arrayname> <key> <value>

  %sUI helpers%s
      hx_head / hx_kv / hx_ok / hx_warn / hx_err / hx_info / hx_badge
      $HX_B $HX_R $HX_GRY $HX_GRN $HX_YEL $HX_RED $HX_ORA

  %sConventions%s
      * private helpers are named _<plugin>_<thing>
      * never call an alias from a function -- call the real command
      * use POSIX  name() { ... }  -- it parses everywhere
      * a prompt cannot expand \$( ); compute into a variable from a hook
      * check your work with:  forge lint <name>

  %sAsking what this hellish can do%s  (never assume a version)
      hx_cap builtin_complete|hooks|rprompt|extglob|...
      conf caps                 the whole probe, cached until the binary changes

' "$HX_B" "$HX_R" "$HX_B" "$HX_R" "$HX_B" "$HX_R" "$HX_B" "$HX_R" \
  "$HX_B" "$HX_R" "$HX_B" "$HX_R" "$HX_B" "$HX_R" "$HX_B" "$HX_R" \
  "$HX_B" "$HX_R" "$HX_B" "$HX_R"
}

hx_complete forge new lint doc list api help
