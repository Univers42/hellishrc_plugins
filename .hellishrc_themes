    hx_build
    printf '%s--- %s %s\n' "$HX_fdark" "$1" "$HX_r"
    printf '%s\n' "$HX_PS1"
    [ -n "$HX_RPS1" ] && printf '   %srps: %s%s\n' "$HX_fdark" "$HX_RPS1" "$HX_r"
    HX_THEME="$hx_old"
    unset hx_old
}

hxp() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    hx_cmd="${1-}"
    [ $# -gt 0 ] && shift
    case "$hx_cmd" in
        ''|show|current)
            printf '%s\n' "$HX_THEME"
            ;;
        list|ls)
            for hx_t in $HX_THEMES; do
                if [ "$hx_t" = "$HX_THEME" ]; then
                    printf '%s* %s%s\n' "$HX_fgreen" "$hx_t" "$HX_r"
                else
                    printf '  %s\n' "$hx_t"
                fi
            done
            unset hx_t
            ;;
        set|use)
            hx_theme_set "${1-}"
            ;;
        next)
            hx_theme_index
            hx_theme_at $(( (HX_IDX + 1) % HX_COUNT ))
            hx_theme_set "$HX_RET"
            printf '%s\n' "$HX_THEME"
            ;;
        prev)
            hx_theme_index
            hx_theme_at $(( (HX_IDX + HX_COUNT - 1) % HX_COUNT ))
            hx_theme_set "$HX_RET"
            printf '%s\n' "$HX_THEME"
            ;;
        random|rand)
            hx_theme_index
            hx_r_=$(( ($$ + $(date +%s 2>/dev/null || echo 7)) % HX_COUNT ))
            hx_theme_at "$hx_r_"
            hx_theme_set "$HX_RET"
            printf '%s\n' "$HX_THEME"
            unset hx_r_
            ;;
        demo|preview)
            if [ -n "${1-}" ]; then
                hx_demo_one "$1"
            else
                for hx_t in $HX_THEMES; do hx_demo_one "$hx_t"; done
                unset hx_t
            fi
            ;;
        save)
            hx_conf_save && printf 'saved to %s\n' "$HX_CONF"
            ;;
        reload)
            . "${HX_RC:-$HOME/.hellishrc}"
            ;;
        colors)
            printf 'mode: %s   unicode: %s   shell: %s\n' \
                "$HX_COLOR" "$HX_UNICODE" "$HX_SHELL"
            hx_i=0
            while [ "$hx_i" -lt 256 ]; do
                printf '%s %3d %s' "$(hx_esc 48 "$hx_i")" "$hx_i" "$HX_r"
                hx_i=$((hx_i + 1))
                [ $((hx_i % 8)) = 0 ] && printf '\n'
            done
            unset hx_i
            ;;
        doctor)
            printf 'hellishrc %s\n' "$HX_VERSION"
            printf '  shell      : %s\n' "$HX_SHELL"
            printf '  color      : %s\n' "$HX_COLOR"
            printf '  unicode    : %s\n' "$HX_UNICODE"
            printf '  theme      : %s (%s available)\n' "$HX_THEME" \
                "$(printf '%s\n' $HX_THEMES | grep -c .)"
            printf '  git        : %s\n' \
                "$(hx_has git && echo yes || echo 'NOT FOUND')"
            printf '  conf       : %s\n' "$HX_CONF"
            printf '  state      : %s\n' "$HX_STATE"
            printf '  path style : %s (max %s)\n' "$HX_PATH_STYLE" "$HX_PATH_MAX"
            printf '  hooks      : %s\n' \
                "$([ "$HX_SHELL" = posix ] && echo 'PS1 substitution' || echo native)"
            ;;
        help|-h|--help)
            printf 'hxp [command]\n\n'
            printf '  (none)        show current theme\n'
            printf '  list          list themes\n'
            printf '  set NAME      switch theme\n'
            printf '  next | prev   cycle themes\n'
            printf '  random        pick one at random\n'
            printf '  demo [NAME]   render theme(s) with live data\n'
            printf '  save          persist config to hellish.conf\n'
            printf '  reload        re-source ~/.hellishrc\n'
            printf '  colors        256-color ramp\n'
            printf '  doctor        capability report\n'
            ;;
        *)
            # `hxp neon` as shorthand for `hxp set neon`
            hx_theme_set "$hx_cmd"
            ;;
    esac
    unset hx_cmd
}

alias theme='hxp'
alias prompt='hxp'

# ============================================================================
# 12. SHELL ERGONOMICS (optional, zsh-flavored, guarded)
# ============================================================================

if [ "$HX_ERGONOMICS" = "1" ] && [ "$HX_SHELL" = "zsh" ]; then
    HISTFILE="$HX_STATE/history"
    HISTSIZE=100000
    SAVEHIST=100000

    setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY 2>/dev/null
    setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE 2>/dev/null
    setopt HIST_REDUCE_BLANKS HIST_VERIFY EXTENDED_HISTORY 2>/dev/null
    setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT 2>/dev/null
    setopt EXTENDED_GLOB GLOB_DOTS NO_CASE_GLOB NUMERIC_GLOB_SORT 2>/dev/null
    setopt INTERACTIVE_COMMENTS LONG_LIST_JOBS NOTIFY 2>/dev/null
    setopt NO_BEEP NO_FLOW_CONTROL 2>/dev/null
    unsetopt CORRECT_ALL 2>/dev/null

    autoload -Uz compinit 2>/dev/null && compinit -C 2>/dev/null
    zstyle ':completion:*' menu select 2>/dev/null
    zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 2>/dev/null
    zstyle ':completion:*' list-colors '' 2>/dev/null
    zstyle ':completion:*:descriptions' format '%F{242}%d%f' 2>/dev/null

    bindkey -e 2>/dev/null
    bindkey '^[[A' history-search-backward 2>/dev/null
    bindkey '^[[B' history-search-forward 2>/dev/null
    bindkey '^[[1;5C' forward-word 2>/dev/null
    bindkey '^[[1;5D' backward-word 2>/dev/null
fi

if [ "$HX_ERGONOMICS" = "1" ]; then
    alias ll='ls -lhF'
    alias la='ls -lAhF'
    alias ..='cd ..'
    alias ...='cd ../..'
    alias ....='cd ../../..'
    alias g='git'
    alias gs='git status --short --branch'
    alias gl='git log --oneline --graph --decorate -20'
    alias gd='git diff'
    alias gds='git diff --staged'

    # mkcd DIR — make it, enter it.
    mkcd() { mkdir -p "$1" && cd "$1" || return 1; }

    # up N — climb N directories.
    up() {
        hx_n="${1:-1}"
        hx_p=''
        while [ "$hx_n" -gt 0 ]; do
            hx_p="../$hx_p"
            hx_n=$((hx_n - 1))
        done
        cd "$hx_p" || return 1
        unset hx_n hx_p
    }

    # ff PATTERN — find files by name below $PWD.
    ff() { find . -type f -name "*$1*" 2>/dev/null; }

    # extract FILE — one command for every archive format.
    extract() {
        [ -f "$1" ] || { printf 'extract: no such file: %s\n' "$1" >&2; return 1; }
        case "$1" in
            *.tar.bz2|*.tbz2) tar xjf "$1" ;;
            *.tar.gz|*.tgz)   tar xzf "$1" ;;
            *.tar.xz)         tar xJf "$1" ;;
            *.tar)            tar xf "$1" ;;
            *.bz2)            bunzip2 "$1" ;;
            *.gz)             gunzip "$1" ;;
            *.zip)            unzip "$1" ;;
            *.7z)             7z x "$1" ;;
            *.rar)            unrar x "$1" ;;
            *) printf 'extract: unknown format: %s\n' "$1" >&2; return 1 ;;
        esac
    }
fi

# ============================================================================
# 13. INIT
# ============================================================================

# Restore persisted theme, unless the environment overrode it.
if [ -z "${HX_THEME-}" ] && [ -r "$HX_STATE/theme" ]; then
    HX_THEME=$(cat "$HX_STATE/theme" 2>/dev/null)
fi
HX_THEME="${HX_THEME:-hellish}"
hx_theme_valid "$HX_THEME" || HX_THEME=hellish

hx_hooks_install

[ -f "$HX_CONF" ] || hx_conf_save

# Local overrides, loaded last so they always win.
[ -r "$HX_HOME/local.sh" ] && . "$HX_HOME/local.sh"

if [ "$HX_BANNER" = "1" ]; then
    printf '%shellish%s %s  %stheme:%s %s  %s%s/%s%s\n' \
        "$HX_fcrim" "$HX_r" "$HX_VERSION" \
        "$HX_fdark" "$HX_r" "$HX_THEME" \
        "$HX_fdark" "$HX_SHELL" "$HX_COLOR" "$HX_r"
fi

fi

# ============================================================================
# Sourcing must never poison the first prompt's exit status.
# ============================================================================
:
