# ~/.hellishrc
# ============================================================================
# HELLISH — monolithic interactive shell rc
# ============================================================================
#
# Single-file, self-contained, zero dependencies beyond a POSIX shell.
#
# Design constraints:
#
#   1. The ENTIRE file is POSIX-parseable. No arrays, no [[ ]], no ${x//a/b}
#      outside of eval, no process substitution. This means dash, bash, zsh
#      and your own hellish(1) can all parse it top to bottom without a
#      syntax error, even if they cannot execute every branch.
#
#   2. Feature detection is runtime, not compile-time. Everything degrades:
#      no colors -> plain text, no unicode -> ASCII, no git -> no vcs segment,
#      no float arithmetic -> second-resolution timings.
#
#   3. `return` is never used at top level. The whole loader is if/else.
#
#   4. The last statement is `:` so sourcing NEVER poisons $? and therefore
#      never makes the first prompt render a bogus failure marker.
#
# Themes:
#
#   25 prompt themes, switchable at runtime, persisted across sessions.
#
#       hxp                 show current theme
#       hxp list            list all themes
#       hxp set neon        switch
#       hxp next / prev     cycle
#       hxp random          surprise
#       hxp demo            render every theme with live data
#       hxp save            persist current theme
#       hxp doctor          capability report
#       hxp colors          color ramp test
#       hxp reload          re-source this file
#
#   Aliases: `theme` and `prompt` map to `hxp`.
#
# Config (env, or ~/.hellish/hellish.conf as plain KEY=VALUE lines):
#
#   HX_THEME            theme name                      (default: hellish)
#   HX_COLOR            auto|24|256|8|none              (default: auto)
#   HX_UNICODE          auto|1|0                        (default: auto)
#   HX_NERD             1|0     powerline/branch glyphs (default: 0)
#   HX_GIT              1|0     enable vcs segment      (default: 1)
#   HX_GIT_DEEP         1|0     ahead/behind/stash      (default: 1)
#   HX_GIT_MAXDEPTH     bail out of huge repos          (default: 1)
#   HX_PATH_MAX         path components before eliding  (default: 4)
#   HX_PATH_STYLE       full|short|tail|fish            (default: full)
#   HX_DUR_MIN          ms before duration shows        (default: 2000)
#   HX_TITLE            1|0     set terminal title      (default: 1)
#   HX_ERGONOMICS       1|0     history/keys/aliases    (default: 1)
#   HX_BANNER           1|0     print load banner       (default: 0)
#
# ============================================================================

# ============================================================================
# 1. SHELL DETECTION + INTERACTIVITY GUARD
# ============================================================================

HX_SHELL=posix
if [ -n "${ZSH_VERSION-}" ]; then
    HX_SHELL=zsh
elif [ -n "${BASH_VERSION-}" ]; then
    HX_SHELL=bash
fi

# Interactive check. `case $- in *i*` is the portable form; zsh keeps $- too.
HX_INTERACTIVE=0
case "$-" in
    *i*) HX_INTERACTIVE=1 ;;
esac

if [ "$HX_INTERACTIVE" = "0" ] && [ -z "${HX_FORCE-}" ]; then
    # Non-interactive. Do nothing at all, but do not error.
    :
else

# ============================================================================
# 2. PATHS, CONFIG, STATE
# ============================================================================

HX_HOME="${HX_HOME:-$HOME/.hellish}"
HX_CONF="${HX_CONF:-$HX_HOME/hellish.conf}"
HX_STATE="${HX_STATE:-$HX_HOME/state}"
HX_VERSION="1.0.0"

export HX_HOME HX_CONF HX_STATE

[ -d "$HX_STATE" ] || mkdir -p "$HX_STATE" 2>/dev/null

# --- defaults ---------------------------------------------------------------
HX_COLOR="${HX_COLOR:-auto}"
HX_UNICODE="${HX_UNICODE:-auto}"
HX_GIT="${HX_GIT:-1}"
HX_GIT_DEEP="${HX_GIT_DEEP:-1}"
HX_GIT_MAXDEPTH="${HX_GIT_MAXDEPTH:-1}"
HX_PATH_MAX="${HX_PATH_MAX:-4}"
HX_PATH_STYLE="${HX_PATH_STYLE:-full}"
HX_DUR_MIN="${HX_DUR_MIN:-2000}"
HX_TITLE="${HX_TITLE:-1}"
HX_ERGONOMICS="${HX_ERGONOMICS:-1}"
HX_BANNER="${HX_BANNER:-0}"

# --- config file ------------------------------------------------------------
# Deliberately dumb parser: KEY=VALUE, one per line, # comments, no quoting
# games, no eval of arbitrary shell. Values are assigned via eval on a
# whitelisted key pattern only.
hx_conf_load() {
    [ -r "$HX_CONF" ] || return 0
    while IFS= read -r hx_line; do
        case "$hx_line" in
            ''|\#*) continue ;;
        esac
        hx_k="${hx_line%%=*}"
        hx_v="${hx_line#*=}"
        case "$hx_k" in
            HX_[A-Z_]*) eval "$hx_k=\"\$hx_v\"" ;;
        esac
    done < "$HX_CONF"
    unset hx_line hx_k hx_v
}

hx_conf_save() {
    [ -d "$HX_HOME" ] || mkdir -p "$HX_HOME" 2>/dev/null || return 1
    {
        echo "# hellish.conf — written by hellishrc $HX_VERSION"
        echo "HX_THEME=$HX_THEME"
        echo "HX_COLOR=$HX_COLOR"
        echo "HX_UNICODE=$HX_UNICODE"
        echo "HX_GIT=$HX_GIT"
        echo "HX_GIT_DEEP=$HX_GIT_DEEP"
        echo "HX_PATH_MAX=$HX_PATH_MAX"
        echo "HX_PATH_STYLE=$HX_PATH_STYLE"
        echo "HX_DUR_MIN=$HX_DUR_MIN"
        echo "HX_TITLE=$HX_TITLE"
        echo "HX_ERGONOMICS=$HX_ERGONOMICS"
    } > "$HX_CONF"
}

hx_conf_load

# ============================================================================
# 3. CAPABILITY DETECTION
# ============================================================================

hx_has() { command -v "$1" >/dev/null 2>&1; }

# --- color depth ------------------------------------------------------------
if [ "$HX_COLOR" = "auto" ]; then
    if [ -n "${NO_COLOR-}" ]; then
        HX_COLOR=none
    elif [ "${TERM-}" = "dumb" ] || [ -z "${TERM-}" ]; then
        HX_COLOR=none
    else
        case "${COLORTERM-}" in
            truecolor|24bit) HX_COLOR=24 ;;
            *)
                hx_n=8
                hx_has tput && hx_n=$(tput colors 2>/dev/null || echo 8)
                case "$hx_n" in
                    ''|*[!0-9]*) hx_n=8 ;;
                esac
                if [ "$hx_n" -ge 256 ]; then HX_COLOR=256; else HX_COLOR=8; fi
                unset hx_n
                ;;
        esac
    fi
fi

# --- unicode ----------------------------------------------------------------
if [ "$HX_UNICODE" = "auto" ]; then
    case "${LC_ALL-}${LC_CTYPE-}${LANG-}" in
        *[Uu][Tt][Ff]*) HX_UNICODE=1 ;;
        *) HX_UNICODE=0 ;;
    esac
fi

# --- prompt-escape wrapping -------------------------------------------------
# Non-printing sequences must be marked or the shell miscomputes line width
# and wrecks multiline editing / history recall.
#
#   zsh   %{ ... %}
#   bash  \001 ... \002   (raw bytes, since we build PS1 dynamically)
#   other nothing
HX_WS=''
HX_WE=''
if [ "$HX_SHELL" = "zsh" ]; then
    HX_WS='%{'
    HX_WE='%}'
elif [ "$HX_SHELL" = "bash" ]; then
    HX_WS=$(printf '\001')
    HX_WE=$(printf '\002')
fi

# ============================================================================
# 4. COLOR ENGINE
# ============================================================================
#
# Escapes are computed ONCE at load into plain variables. Rendering a prompt
# is then pure string concatenation: no subshells, no forks, no measurable
# cost per keystroke.

# 256-index -> ANSI 30..37 fallback, so 8-color terminals still get sane hues.
hx_basic8() {
    case "$1" in
        16|232|233|234|235|236|237|238|239|240) echo 30 ;;
        1|9|52|88|124|160|196|197|203|204|210)  echo 31 ;;
        2|10|22|28|34|40|46|76|82|114|118|154)  echo 32 ;;
        3|11|136|172|178|180|184|214|220|222|223) echo 33 ;;
        4|12|17|19|25|27|33|39|67|69|75|111)    echo 34 ;;
        5|13|54|90|93|127|129|135|141|176|177|212|213) echo 35 ;;
        6|14|30|37|44|45|50|51|80|86|87|116)    echo 36 ;;
        *) echo 37 ;;
    esac
}

# hx_esc <38|48> <256-index>
hx_esc() {
    case "$HX_COLOR" in
        none) return 0 ;;
        8)
            hx_b8=$(hx_basic8 "$2")
            [ "$1" = "48" ] && hx_b8=$((hx_b8 + 10))
            printf '%s\033[%sm%s' "$HX_WS" "$hx_b8" "$HX_WE"
            ;;
        *)
            printf '%s\033[%s;5;%sm%s' "$HX_WS" "$1" "$2" "$HX_WE"
            ;;
    esac
}

hx_sgr() {
    [ "$HX_COLOR" = "none" ] && return 0
    printf '%s\033[%sm%s' "$HX_WS" "$1" "$HX_WE"
}

# hx_palette: fill HX_f* (foreground) and HX_b* (background) + attributes.
hx_palette() {
    HX_r=$(hx_sgr 0)
    HX_bd=$(hx_sgr 1)
    HX_dm=$(hx_sgr 2)
    HX_it=$(hx_sgr 3)
    HX_ul=$(hx_sgr 4)
    HX_rv=$(hx_sgr 7)

    for hx_spec in \
        fblack:236 fgrey:244 fdark:240 fslate:246 fwhite:252 fsnow:255 \
        fred:203 fblood:160 fcrim:197 fpink:212 forange:209 fsand:223 \
        fyellow:180 fgold:214 flime:154 facid:118 fgreen:114 fmoss:71 \
        fteal:44 fcyan:80 fneon:51 fsky:117 fblue:75 fsteel:67 fdeep:33 \
        fviolet:141 fpurple:135 fmagenta:176 fmauve:183 \
        bblack:236 bgrey:240 bred:160 bgreen:29 byellow:136 bblue:25 \
        bmagenta:90 bcyan:30 bwhite:250 bviolet:54 borange:130 bsteel:60
    do
        hx_n="${hx_spec%%:*}"
        hx_c="${hx_spec#*:}"
        case "$hx_n" in
            f*) eval "HX_$hx_n=\$(hx_esc 38 $hx_c)" ;;
            b*) eval "HX_$hx_n=\$(hx_esc 48 $hx_c)" ;;
        esac
    done
    unset hx_spec hx_n hx_c
}
hx_palette

# ============================================================================
# 5. GLYPHS
# ============================================================================

if [ "$HX_UNICODE" = "1" ]; then
    HX_G_TL='╭'; HX_G_BL='╰'; HX_G_V='│'; HX_G_H='─'
    HX_G_ARR='❯'; HX_G_LAM='λ'; HX_G_OK='✓'; HX_G_BAD='✘'
    HX_G_BR='⎇'; HX_G_ELL='…'; HX_G_DOT='•'; HX_G_STAR='★'
    HX_G_PL='▶'; HX_G_PLT='❯'; HX_G_UP='↑'; HX_G_DN='↓'
    HX_G_STASH='⚑'; HX_G_LOCK='⚿'; HX_G_BOLT='⚡'; HX_G_CLK='⏱'
    HX_G_TLB='┌'; HX_G_BLB='└'; HX_G_TR='╮'; HX_G_HASH='#'
    HX_G_DIAM='◆'; HX_G_SQ='▪'; HX_G_TRI='▸'; HX_G_HALF='▓'
else
    HX_G_TL='.'; HX_G_BL='`'; HX_G_V='|'; HX_G_H='-'
    HX_G_ARR='>'; HX_G_LAM='\\'; HX_G_OK='+'; HX_G_BAD='x'
    HX_G_BR='git'; HX_G_ELL='..'; HX_G_DOT='*'; HX_G_STAR='*'
    HX_G_PL='>'; HX_G_PLT='>'; HX_G_UP='^'; HX_G_DN='v'
    HX_G_STASH='$'; HX_G_LOCK='#'; HX_G_BOLT='!'; HX_G_CLK='@'
    HX_G_TLB='+'; HX_G_BLB='+'; HX_G_TR='+'; HX_G_HASH='#'
    HX_G_DIAM='<>'; HX_G_SQ='#'; HX_G_TRI='>'; HX_G_HALF='#'
fi

# Nerd Font glyphs (U+E0B0 U+E0B1 U+E0A0). Off by default: they render as
# tofu without a patched font. Enable with HX_NERD=1 or `conf set HX_NERD 1`.
# Written as octal escapes so this file stays 7-bit clean and survives any
# copy/paste, editor or terminal that would otherwise eat private-use chars.
HX_NERD="${HX_NERD:-0}"
if [ "$HX_NERD" = "1" ] && [ "$HX_UNICODE" = "1" ]; then
    HX_G_PL=$(printf '\356\202\260')
    HX_G_PLT=$(printf '\356\202\261')
    HX_G_BR=$(printf '\356\202\240')
fi

HX_NL='
'

# ============================================================================
# 6. UTILITIES
# ============================================================================

# Escape % so zsh prompt expansion cannot be hijacked by a path or branch
# name containing a percent sign. This is a real bug in most dotfiles.
hx_pct() {
    if [ "$HX_SHELL" = "zsh" ]; then
        eval 'HX_RET=${1//\%/%%}'
    else
        HX_RET="$1"
    fi
}

# hx_dur <milliseconds> -> human string in HX_RET
hx_dur() {
    hx_ms=$1
    if [ "$hx_ms" -lt 1000 ]; then
        HX_RET="${hx_ms}ms"
    elif [ "$hx_ms" -lt 60000 ]; then
        HX_RET="$((hx_ms / 1000)).$(( (hx_ms % 1000) / 100 ))s"
    elif [ "$hx_ms" -lt 3600000 ]; then
        HX_RET="$((hx_ms / 60000))m$(( (hx_ms % 60000) / 1000 ))s"
    else
        HX_RET="$((hx_ms / 3600000))h$(( (hx_ms % 3600000) / 60000 ))m"
    fi
    unset hx_ms
}

# hx_shorten <path> -> HX_RET, honoring HX_PATH_STYLE / HX_PATH_MAX
hx_shorten() {
    hx_p="$1"
    case "$hx_p" in
        "$HOME") hx_p='~' ;;
        "$HOME"/*) hx_p="~${hx_p#"$HOME"}" ;;
    esac

    case "$HX_PATH_STYLE" in
        tail)
            case "$hx_p" in
                */*) hx_p="${hx_p##*/}" ;;
            esac
            ;;
        fish|short)
            # ~/dev/projects/hellish -> ~/d/p/hellish
            hx_out=''
            hx_rest="$hx_p"
            hx_last="${hx_p##*/}"
            [ "$hx_last" = "$hx_p" ] && hx_last=''
            while [ -n "$hx_rest" ]; do
                hx_seg="${hx_rest%%/*}"
                case "$hx_rest" in
                    */*) hx_rest="${hx_rest#*/}" ;;
                    *) hx_rest='' ;;
                esac
                if [ -z "$hx_rest" ] && [ -n "$hx_last" ]; then
                    hx_out="$hx_out/$hx_seg"
                elif [ -z "$hx_seg" ]; then
                    :
                else
                    case "$hx_seg" in
                        .?*) hx_out="$hx_out/$(printf '%.2s' "$hx_seg")" ;;
                        *)   hx_out="$hx_out/$(printf '%.1s' "$hx_seg")" ;;
                    esac
                fi
            done
            hx_p="${hx_out#/}"
            case "$1" in
                /*) [ "${hx_p#\~}" = "$hx_p" ] && hx_p="/$hx_p" ;;
            esac
            unset hx_out hx_rest hx_seg hx_last
            ;;
        *)
            # full, but elide the middle past HX_PATH_MAX components
            hx_cnt=0
            hx_tmp="$hx_p"
            while [ -n "$hx_tmp" ]; do
                case "$hx_tmp" in
                    */*) hx_tmp="${hx_tmp#*/}"; hx_cnt=$((hx_cnt + 1)) ;;
                    *) hx_tmp=''; hx_cnt=$((hx_cnt + 1)) ;;
                esac
            done
            if [ "$hx_cnt" -gt "$HX_PATH_MAX" ]; then
                hx_drop=$((hx_cnt - HX_PATH_MAX))
                hx_tmp="$hx_p"
                while [ "$hx_drop" -gt 0 ]; do
                    hx_tmp="${hx_tmp#*/}"
                    hx_drop=$((hx_drop - 1))
                done
                hx_p="$HX_G_ELL/$hx_tmp"
            fi
            unset hx_cnt hx_tmp hx_drop
            ;;
    esac

    HX_RET="$hx_p"
    unset hx_p
}

# ============================================================================
# 7. CONTEXT COLLECTORS
# ============================================================================

# --- git --------------------------------------------------------------------
# Four cheap plumbing calls beat one --porcelain parse loop in a shell.
# Everything is guarded: a missing/broken git NEVER breaks a prompt.
hx_git_collect() {
    HX_GB=''; HX_GF=''; HX_GA=0; HX_GBH=0; HX_GS=0; HX_GST=''; HX_GDIRTY=0

    [ "$HX_GIT" = "1" ] || return 0
    hx_has git || return 0
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

    HX_GB=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [ -z "$HX_GB" ]; then
        HX_GB=$(git rev-parse --short HEAD 2>/dev/null)
        HX_GB="${HX_G_DIAM}${HX_GB}"   # detached
    fi

    hx_gd=$(git rev-parse --git-dir 2>/dev/null)
    if [ -n "$hx_gd" ]; then
        if [ -d "$hx_gd/rebase-merge" ] || [ -d "$hx_gd/rebase-apply" ]; then
            HX_GST='rebase'
        elif [ -f "$hx_gd/MERGE_HEAD" ]; then
            HX_GST='merge'
        elif [ -f "$hx_gd/CHERRY_PICK_HEAD" ]; then
            HX_GST='cherry'
        elif [ -f "$hx_gd/BISECT_LOG" ]; then
            HX_GST='bisect'
        fi
    fi

    git diff --cached --quiet 2>/dev/null || { HX_GF="${HX_GF}+"; HX_GDIRTY=1; }
    git diff --quiet 2>/dev/null        || { HX_GF="${HX_GF}~"; HX_GDIRTY=1; }
    if [ -n "$(git ls-files --others --exclude-standard 2>/dev/null | head -n 1)" ]; then
        HX_GF="${HX_GF}?"
        HX_GDIRTY=1
    fi
    if git ls-files --unmerged 2>/dev/null | head -n 1 | grep -q .; then
        HX_GF="${HX_GF}!"
        HX_GDIRTY=1
    fi

    if [ "$HX_GIT_DEEP" = "1" ]; then
        hx_ab=$(git rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null)
        if [ -n "$hx_ab" ]; then
            HX_GBH="${hx_ab%%	*}"
            HX_GA="${hx_ab##*	}"
            case "$HX_GBH" in ''|*[!0-9]*) HX_GBH=0 ;; esac
            case "$HX_GA"  in ''|*[!0-9]*) HX_GA=0 ;;  esac
        fi
        HX_GS=$(git rev-list --walk-reflogs --count refs/stash 2>/dev/null || echo 0)
        case "$HX_GS" in ''|*[!0-9]*) HX_GS=0 ;; esac
    fi

    hx_pct "$HX_GB"; HX_GB="$HX_RET"
    unset hx_gd hx_ab
}

# Composed git label used by most themes: main+~ ↑2 ↓1 ⚑3 (merge)
hx_git_label() {
    HX_GLABEL=''
    [ -n "$HX_GB" ] || return 0
    HX_GLABEL="$HX_GB$HX_GF"
    [ "$HX_GA"  -gt 0 ] 2>/dev/null && HX_GLABEL="$HX_GLABEL $HX_G_UP$HX_GA"
    [ "$HX_GBH" -gt 0 ] 2>/dev/null && HX_GLABEL="$HX_GLABEL $HX_G_DN$HX_GBH"
    [ "$HX_GS"  -gt 0 ] 2>/dev/null && HX_GLABEL="$HX_GLABEL $HX_G_STASH$HX_GS"
    [ -n "$HX_GST" ] && HX_GLABEL="$HX_GLABEL ($HX_GST)"
    :
}

# --- language / env ---------------------------------------------------------
hx_env_collect() {
    HX_VENV=''
    [ -n "${VIRTUAL_ENV-}" ] && HX_VENV="${VIRTUAL_ENV##*/}"
    [ -n "${CONDA_DEFAULT_ENV-}" ] && HX_VENV="${CONDA_DEFAULT_ENV}"
    [ -n "$HX_VENV" ] && { hx_pct "$HX_VENV"; HX_VENV="$HX_RET"; }

    # Only probe toolchains when a marker file is present in $PWD. Cheap.
    HX_LANG=''
    if [ -f package.json ] && hx_has node; then
        HX_LANG="node $(node -v 2>/dev/null)"
    elif [ -f Cargo.toml ] && hx_has rustc; then
        HX_LANG="rust $(rustc --version 2>/dev/null | cut -d' ' -f2)"
    elif [ -f go.mod ] && hx_has go; then
        HX_LANG="go $(go env GOVERSION 2>/dev/null)"
    elif { [ -f pyproject.toml ] || [ -f requirements.txt ]; } && hx_has python3; then
        HX_LANG="py $(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)"
    elif [ -f Makefile ] || [ -f makefile ]; then
        HX_LANG="make"
    fi
    :
}

hx_misc_collect() {
    HX_U="${USER:-${LOGNAME:-$(id -un 2>/dev/null)}}"
    HX_H="${HOSTNAME:-$(hostname 2>/dev/null || echo localhost)}"
    HX_H="${HX_H%%.*}"

    HX_SSHF=0
    { [ -n "${SSH_CONNECTION-}" ] || [ -n "${SSH_TTY-}" ]; } && HX_SSHF=1

    HX_PRIV='$'
    HX_ROOT=0
    if [ "$(id -u 2>/dev/null || echo 1000)" = "0" ]; then
        HX_PRIV='#'
        HX_ROOT=1
    fi

    HX_JOBS=$(jobs 2>/dev/null | grep -c . 2>/dev/null || echo 0)
    case "$HX_JOBS" in ''|*[!0-9]*) HX_JOBS=0 ;; esac

    HX_TIME=$(date '+%H:%M:%S' 2>/dev/null)
    HX_DATE=$(date '+%d %b' 2>/dev/null)
    :
}

# ============================================================================
# 8. TIMING
# ============================================================================

HX_T0=''
HX_MS=0

hx_now_ms() {
    if [ "$HX_SHELL" = "zsh" ] && [ -n "${EPOCHREALTIME-}" ]; then
        eval 'HX_RET=$(( int(EPOCHREALTIME * 1000) ))'
    else
        HX_RET=$(($(date +%s 2>/dev/null || echo 0) * 1000))
    fi
}

hx_preexec() {
    hx_now_ms
    HX_T0="$HX_RET"
}

hx_timing() {
    HX_MS=0
    HX_DURSTR=''
    if [ -n "$HX_T0" ]; then
        hx_now_ms
        HX_MS=$((HX_RET - HX_T0))
        [ "$HX_MS" -lt 0 ] && HX_MS=0
        if [ "$HX_MS" -ge "$HX_DUR_MIN" ]; then
            hx_dur "$HX_MS"
            HX_DURSTR="$HX_RET"
        fi
    fi
    HX_T0=''
}

# ============================================================================
# 9. THEMES
# ============================================================================
#
# Contract for every theme function:
#
#   INPUT  (globals, already escaped and safe to interpolate)
#     HX_X        last exit code            HX_XOK    1 if success
#     HX_P        display path              HX_U/HX_H user / host
#     HX_GLABEL   git label ('' if none)    HX_GDIRTY 1 if worktree dirty
#     HX_VENV     virtualenv name           HX_LANG   toolchain hint
#     HX_TIME     HH:MM:SS                  HX_DURSTR command duration
#     HX_JOBS     background job count      HX_SSHF   1 if over ssh
#     HX_PRIV     $ or #                    HX_NL     newline
#
#   OUTPUT
#     HX_PS1      left prompt
#     HX_RPS1     right prompt (zsh only; ignored elsewhere)
#
# Every theme must be legible with HX_COLOR=none.

HX_THEMES="hellish minimal pure powerline agnoster lambda classic bracket
arrow dots matrix neon rails compact zen dev boxed ascii hex night ocean
