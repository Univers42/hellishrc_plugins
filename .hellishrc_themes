# ============================================================================
# 10. RENDERER + HOOKS
# ============================================================================

hx_collect() {
    HX_X="$1"
    case "$HX_X" in ''|*[!0-9]*) HX_X=0 ;; esac
    HX_XOK=1
    [ "$HX_X" = "0" ] || HX_XOK=0

    hx_shorten "$PWD"
    hx_pct "$HX_RET"
    HX_P="$HX_RET"

    hx_misc_collect
    hx_git_collect
    hx_git_label
    hx_env_collect
    :
}

hx_title() {
    [ "$HX_TITLE" = "1" ] || return 0
    case "${TERM-}" in
        xterm*|rxvt*|screen*|tmux*|alacritty*|foot*|kitty*|wezterm*)
            printf '\033]0;%s@%s: %s\007' "$HX_U" "$HX_H" "$PWD"
            ;;
    esac
}

# Build HX_PS1/HX_RPS1 for the active theme, with a hard fallback if the
# theme function is missing or explodes.
hx_build() {
    HX_PS1=''
    HX_RPS1=''
    if hx_has "hx_theme_$HX_THEME"; then
        "hx_theme_$HX_THEME" 2>/dev/null
    fi
    if [ -z "$HX_PS1" ]; then
        HX_PS1="$HX_U@$HX_H $HX_P$HX_PRIV "
        HX_RPS1=''
    fi
}

hx_precmd() {
    HX_LAST=$?
    hx_timing
    hx_collect "$HX_LAST"
    hx_build
    hx_title
    PS1="$HX_PS1"
    PS2="$HX_fdark$HX_G_H$HX_G_H$HX_G_TRI$HX_r "
    if [ "$HX_SHELL" = "zsh" ]; then
        RPS1="$HX_RPS1"
        RPROMPT="$HX_RPS1"
    fi
    :
}

# One-shot renderer for shells with no precmd hook (dash, and hellish while
# hooks are unimplemented). PS1 is expanded per POSIX with parameter
# expansion + command substitution, so this runs on every prompt.
hx_render() {
    hx_collect "${1:-0}"
    hx_build
    printf '%s' "$HX_PS1"
}

hx_hooks_install() {
    if [ "$HX_SHELL" = "zsh" ]; then
        setopt PROMPT_SUBST 2>/dev/null
        setopt PROMPT_PERCENT 2>/dev/null
        setopt TRANSIENT_RPROMPT 2>/dev/null
        # Defined as plain functions so this file stays POSIX-parseable.
        # If you already use add-zsh-hook elsewhere, drop these two defs.
        precmd() { hx_precmd; }
        preexec() { hx_preexec; }
        hx_precmd
    elif [ "$HX_SHELL" = "bash" ]; then
        PROMPT_COMMAND=hx_precmd
        trap 'hx_preexec' DEBUG 2>/dev/null
        hx_precmd
    else
        # POSIX fallback: $? is expanded at prompt time, inside the subshell.
        PS1='$(hx_render "$?")'
        PS2='> '
    fi
    :
}

# ============================================================================
# 11. CONTROL COMMAND: hxp
# ============================================================================

hx_theme_valid() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    for hx_t in $HX_THEMES; do
        [ "$hx_t" = "$1" ] && { unset hx_t; return 0; }
    done
    unset hx_t
    return 1
}

hx_theme_set() {
    if hx_theme_valid "$1"; then
        HX_THEME="$1"
        hx_hooks_install
        printf '%s\n' "$HX_THEME" > "$HX_STATE/theme" 2>/dev/null
        return 0
    fi
    printf 'hxp: unknown theme: %s\n' "$1" >&2
    printf 'hxp: try `hxp list`\n' >&2
    return 1
}

hx_theme_index() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    hx_i=0
    hx_found=-1
    for hx_t in $HX_THEMES; do
        [ "$hx_t" = "$HX_THEME" ] && hx_found=$hx_i
        hx_i=$((hx_i + 1))
    done
    HX_COUNT=$hx_i
    HX_IDX=$hx_found
    unset hx_i hx_found hx_t
}

hx_theme_at() {
    [ "$HX_SHELL" = "zsh" ] && setopt localoptions shwordsplit 2>/dev/null
    hx_i=0
    for hx_t in $HX_THEMES; do
        if [ "$hx_i" = "$1" ]; then
            HX_RET="$hx_t"
            unset hx_i hx_t
            return 0
        fi
        hx_i=$((hx_i + 1))
    done
    HX_RET=hellish
    unset hx_i hx_t
    return 1
}

