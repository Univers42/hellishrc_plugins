#!/bin/sh
# bin/hx-fetch-plugin — fetch ONE external plugin from the catalog into the
# plugin directory, with a generated plugin.hsh wrapper.
#
#   hx-fetch-plugin <name> [--home DIR]
#
# This is the single implementation of "install an external plugin": the
# framework installer calls it at setup time, and `hxp install` calls it from
# inside a running hellish. One fetcher means the wrapper format can never
# fork into two dialects.
#
# The downloaded file KEEPS its original name. That is load-bearing for
# .zsh plugins: hellish arms its zsh dialect when it sources a path ending
# in .zsh, and disarms it when the file ends -- so a real oh-my-zsh plugin
# parses as zsh without the wrapper saying anything about dialects.
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: hx-fetch-plugin <name> [--home DIR]" >&2; exit 2; }
shift
TARGET_HOME="$HOME"
while [ $# -gt 0 ]; do
	case "$1" in
	--home) shift; TARGET_HOME="$1" ;;
	*) echo "hx-fetch-plugin: unknown argument '$1'" >&2; exit 2 ;;
	esac
	shift
done
CATALOG="$HERE/plugins/catalog.tsv"
[ -f "$CATALOG" ] || CATALOG="$TARGET_HOME/.hellish/plugins/catalog.tsv"
[ -f "$CATALOG" ] || { echo "hx-fetch-plugin: no catalog found" >&2; exit 1; }

row="$(grep -v '^#' "$CATALOG" | awk -F'\t' -v n="$NAME" '$1 == n { print; exit }')"
[ -n "$row" ] || { echo "hx-fetch-plugin: '$NAME' is not in the catalog" >&2; exit 1; }
kind="$(printf '%s' "$row" | cut -f2)"
url="$(printf '%s' "$row" | cut -f3)"
desc="$(printf '%s' "$row" | cut -f5)"

if [ "$kind" = "builtin" ]; then
	echo "hx-fetch-plugin: '$NAME' ships with the framework -- enable it with: conf on $NAME" >&2
	exit 1
fi

DEST="$TARGET_HOME/.hellish/plugins/$NAME"
FILE="${url##*/}"
mkdir -p "$DEST"
if command -v curl >/dev/null 2>&1; then
	curl -fsSL "$url" -o "$DEST/$FILE"
else
	wget -q -O "$DEST/$FILE" "$url"
fi
[ -s "$DEST/$FILE" ] || { rm -rf "$DEST"; echo "hx-fetch-plugin: empty download for $NAME" >&2; exit 1; }

{
	printf '# plugins/%s/plugin.hsh -- generated by hx-fetch-plugin. %s\n' "$NAME" "$desc"
	printf '# The fetched file keeps its name: a .zsh path arms the zsh dialect.\n'
	printf 'hx_plugin %s on external "%s" || return 0\n' "$NAME" "$desc"
	# git's completion registers `complete` specs; they only reach TAB when
	# progcomp is armed, and someone who installed a completion plugin has
	# answered that question. Everyone else keeps hellish's default.
	[ "$NAME" = "git-completion" ] && printf 'shopt -s progcomp\n'
	printf '. "$HX_PLUGIN_DIR/%s/%s"\n' "$NAME" "$FILE"
} > "$DEST/plugin.hsh"

echo "hx-fetch-plugin: installed $NAME -> $DEST"
