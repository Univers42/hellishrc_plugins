# test/rc_history.hsh — rc.d/60-history.hsh: the history settings, h and
# histtop.
#
# HISTFILE points into $T_DIR before anything touches the history list, so
# the real history file is never read or written. h runs against entries
# added with `history -s`; histtop's parsing is checked against a stand-in
# `history` printing bash's timestamped format, and against the real one
# where that prints timestamps too.

if ! hx_enabled history; then t_skip "rc.d/60-history.hsh — the history module is off"; return 0; fi

HISTFILE="$T_DIR/history"

t_head "history: settings"

_hi_vars="HISTFILE HISTSIZE HISTFILESIZE HISTCONTROL HISTIGNORE HISTTIMEFORMAT"
_hi_sh=$(command -v sh)
# _hi_load [NAME=value...] — source 60-history.hsh again in a subshell, with
# its variables and HX_HIST_SIZE unset (then the given ones set); prints
# NAME=value for each, then what a child process inherited
_hi_load() {
    (
        for _hi_v in $_hi_vars HX_HIST_SIZE; do unset "$_hi_v"; done
        for _hi_v in "$@"; do eval "${_hi_v%%=*}=\"\${_hi_v#*=}\""; done
        . "$HX_HOME/rc.d/60-history.hsh"
        for _hi_v in $_hi_vars; do eval "printf '%s=%s\n' \"\$_hi_v\" \"\${$_hi_v-<unset>}\""; done
        "$_hi_sh" -c 'printf "child:HISTCONTROL=%s\n" "$HISTCONTROL"'
    ) 2>&1
}
_hi_get() { printf '%s\n' "$2" | sed -n "s/^$1=//p" | head -1; }

_hi_o=$(_hi_load)
t_eq "$HOME/.hellish_history" "$(_hi_get HISTFILE "$_hi_o")" "history is kept in ~/.hellish_history"
t_eq "20000" "$(_hi_get HISTSIZE "$_hi_o")" "HISTSIZE defaults to 20000"
t_eq "20000" "$(_hi_get HISTFILESIZE "$_hi_o")" "HISTFILESIZE defaults to 20000"
t_eq "ignoredups:ignorespace:erasedups" "$(_hi_get HISTCONTROL "$_hi_o")" \
    "HISTCONTROL drops duplicates and anything typed after a leading space"
t_eq "ls:ll:la:cd:cd -:pwd:exit:clear:history:h:hxl" "$(_hi_get HISTIGNORE "$_hi_o")" \
    "HISTIGNORE keeps the noise commands out"
t_eq "%F %T " "$(_hi_get HISTTIMEFORMAT "$_hi_o")" "HISTTIMEFORMAT defaults to '%F %T '"
t_eq "ignoredups:ignorespace:erasedups" "$(_hi_get child:HISTCONTROL "$_hi_o")" "the settings are exported"

_hi_o=$(_hi_load HX_HIST_SIZE=500)
t_eq "500|500" "$(_hi_get HISTSIZE "$_hi_o")|$(_hi_get HISTFILESIZE "$_hi_o")" \
    "HX_HIST_SIZE sets both HISTSIZE and HISTFILESIZE"
_hi_o=$(_hi_load HISTFILE="$T_DIR/mine" HISTCONTROL=ignoreboth HISTIGNORE=x HISTTIMEFORMAT=%T)
t_eq "$T_DIR/mine" "$(_hi_get HISTFILE "$_hi_o")" "a HISTFILE already set is kept"
t_eq "ignoreboth" "$(_hi_get HISTCONTROL "$_hi_o")" "a HISTCONTROL already set is kept"
t_eq "x" "$(_hi_get HISTIGNORE "$_hi_o")" "a HISTIGNORE already set is kept"
t_eq "%T" "$(_hi_get HISTTIMEFORMAT "$_hi_o")" "a HISTTIMEFORMAT already set is kept"

# ── h ───────────────────────────────────────────────────────────────────────
t_head "history: h"

history -c
for _hi_c in "git status" "make test" "Git push" "grep -rn needle ."; do history -s "$_hi_c"; done
_hi_o=$(h)
t_eq "4" "$(printf '%s\n' "$_hi_o" | wc -l | tr -d ' ')" "h with no pattern shows the history"
t_has "make test" "$_hi_o" "and the commands in it"
t_eq "2" "$(h git | wc -l | tr -d ' ')" "h matches case-insensitively"
t_eq "1" "$(h git status | wc -l | tr -d ' ')" "h joins several words into one pattern"
t_has "grep -rn needle" "$(h -rn)" "h takes a pattern that starts with a dash"
t_rc 1 "h fails when nothing matches" h zzz-nothing
t_rc 0 "h succeeds when something matches" h make

history -c
_hi_i=1
while [ "$_hi_i" -le 40 ]; do history -s "cmd$_hi_i"; _hi_i=$((_hi_i + 1)); done
_hi_o=$(h)
t_eq "30" "$(printf '%s\n' "$_hi_o" | wc -l | tr -d ' ')" "h with no pattern shows only the last 30 entries"
t_has "cmd40" "$(printf '%s\n' "$_hi_o" | tail -1)" "the newest entry last"
t_has "cmd11" "$(printf '%s\n' "$_hi_o" | head -1)" "the oldest shown is the 30th from the end"

# ── histtop ─────────────────────────────────────────────────────────────────
t_head "history: histtop"

# _hi_top [n] — histtop over a stand-in history, in bash's format for the
# HISTTIMEFORMAT this module sets: number, date, time, command
_hi_top() {
    (
        history() {
            local i=0 c
            for c in "git status" "make" "git push" "ls -la" "make test" "git log --oneline" \
                     a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14; do
                i=$((i + 1))
                printf '%5d  2026-09-25 10:00:%02d %s\n' "$i" "$i" "$c"
            done
        }
        histtop "$@"
    ) | sed 's/^ *//'
}
t_eq "3 git|2 make|1 ls" "$(_hi_top 3 | tr '\n' '|' | sed 's/|$//')" \
    "histtop counts each command by its first word, most used first"
t_eq "2" "$(_hi_top 2 | wc -l | tr -d ' ')" "histtop N shows N commands"
t_eq "15" "$(_hi_top | wc -l | tr -d ' ')" "histtop shows 15 by default"

history -c
for _hi_c in "git status" "git push" "make"; do history -s "$_hi_c"; done
if history | head -1 | grep -qE '^ *[0-9]+  [0-9]{4}-[0-9]{2}-[0-9]{2} '; then
    t_eq "2 git" "$(histtop | head -1 | sed 's/^ *//')" "histtop counts the commands in the real history"
else
    t_skip "histtop over the real history — hellish's history ignores HISTTIMEFORMAT, and histtop strips the timestamp it expects"
fi
history -c
